			<< " hMax=" << adaptHMax
			<< " err=" << adaptErr
			<< endl;

		if (plt == 1 && plotAdaptOverlay == 1)
		{
			plot(Th, rhoFromPhi, fill=true, value=true, wait=false, nbiso=60,
				cmm="Before adapt: rho=f(u) with mesh overlay");
		}

		Th = adaptmesh(
			Th,
			rhoFromPhi,
			u,
			err=adaptErr,
			errg=adaptErrG,
			hmin=hMinUsed,
			hmax=adaptHMax,
			nbvx=adaptNbVx,
			ratio=adaptRatio,
			anisomax=adaptAnisoMax,
			nbsmooth=adaptNbSmooth,
			verbosity=adaptVerbosity
		);

		// Important: interpolate/rebind all FE functions after adaptmesh.
		T = T;
		phiDesign = phiDesign;
		rhoDesign = rhoDesign;
		u = u;
		du = 0;
		uTrial = u;
		uOld = u;
		rhoFromPhi = ffun(u);
		gradTNorm = sqrt(dx(T)^2 + dy(T)^2);
		activeDesign = (rhoDesign > activeThreshold*rhoAmp);
		plateauDesign = (rhoDesign > plateauThreshold*rhoAmp);

		// Do not reuse/reassign K/M after adaptmesh.
		// Metric solve below uses HminusResidualSolve on the current adapted FE space.
		tmp = 0.0;
		phiCheck = 0.0;
		zHminus = 0.0;

		// Refresh design norms/diagnostics on the adapted mesh.
		rhoDesignMass = int2d(Th)(rhoDesign);
		rhoDesignL2 = sqrt(int2d(Th)(rhoDesign^2));
		phiDesignMax = phiDesign[].max;
		phiDesignMin = phiDesign[].min;

		real ntNew = Th.nt;
		real ndofNew = Vh.ndof;
		real rhoMassAfterAdapt = int2d(Th)(rhoFromPhi);
		real rhoMaxAfterAdapt = rhoFromPhi[].max;
		real massRelChange = abs(rhoMassAfterAdapt-rhoMassBeforeAdapt)/max(abs(rhoMassBeforeAdapt), 1e-30);
		real maxRhoRelChange = abs(rhoMaxAfterAdapt-rhoMaxBeforeAdapt)/max(abs(rhoMaxBeforeAdapt), 1e-30);
		real adaptTime = clock()-tAdapt;

		cout
			<< "ADAPT_DONE "
			<< "ieps=" << ieps
			<< " ntNew=" << ntNew
			<< " ndofNew=" << ndofNew
			<< " massRelChange=" << massRelChange
			<< " time=" << adaptTime
			<< endl;

		humanlog
			<< "ADAPT_DONE "
			<< "ieps=" << ieps << " "
			<< "ntOld=" << ntOld << " "
			<< "ndofOld=" << ndofOld << " "
			<< "ntNew=" << ntNew << " "
			<< "ndofNew=" << ndofNew << " "
			<< "epsPhi=" << epsPhi << " "
			<< "maxGradPhi=" << maxGradPhi << " "
			<< "hTarget=" << hTarget << " "
			<< "hMinUsed=" << hMinUsed << " "
			<< "hMax=" << adaptHMax << " "
			<< "err=" << adaptErr << " "
			<< "rhoMassAfter=" << rhoMassAfterAdapt << " "
			<< "rhoMaxAfter=" << rhoMaxAfterAdapt << " "
			<< "massRelChange=" << massRelChange << " "
			<< "time=" << adaptTime
			<< endl;

		adaptlog
			<< "ADAPT" << ","
			<< runTag << ","
			<< ieps << ","
			<< ntOld << ","
			<< ndofOld << ","
			<< ntNew << ","
			<< ndofNew << ","
			<< epsPhi << ","
			<< maxGradPhi << ","
			<< hTarget << ","
			<< hMinUsed << ","
			<< adaptHMax << ","
			<< adaptErr << ","
			<< adaptErrG << ","
			<< adaptRatio << ","
			<< adaptAnisoMax << ","
			<< rhoMassBeforeAdapt << ","
			<< rhoMaxBeforeAdapt << ","
			<< rhoMassAfterAdapt << ","
			<< rhoMaxAfterAdapt << ","
			<< massRelChange << ","
			<< maxRhoRelChange << ","
			<< adaptTime << ","
			<< "ADAPT_DONE"
			<< endl;

		if (plt == 1 && plotAdaptOverlay == 1)
		{
			plot(Th, rhoFromPhi, fill=true, value=true, wait=false, nbiso=60,
				cmm="After adapt: rho=f(u) with adapted mesh overlay");
		}

		savevtk(vtkDir + "/" + runTag + "_adapt_stage_" + ieps + ".vtu", Th, u, rhoFromPhi, rhoDesign, phiDesign,
			dataname="phi rho rhoDesign phiDesign");
	}
}

// ----------------------------
// Final solution and diagnostics
// ----------------------------
/* inline ComputeFastMetrics */
tMetrics = clock();
rhoFromPhi = ffun(u);
activeFinal = (rhoFromPhi > activeThreshold*rhoAmp);
plateauFinal = (rhoFromPhi > plateauThreshold*rhoAmp);

rr.resize(Vh.ndof);
rr = 0.0;
rr = ResidualForm(0, Vh);
resEuclid = sqrt(rr'*rr);

zHminus = 0.0;
HminusResidualSolve;
resHm1 = sqrt(int2d(Th)(dx(zHminus)^2 + dy(zHminus)^2));

rhoL2Now = sqrt(int2d(Th)(rhoFromPhi^2));
energyPhiNow = sqrt(int2d(Th)(dx(u)^2 + dy(u)^2));

resHm1RelEnergy = resHm1/max(energyPhiNow, 1e-30);
resHm1RelRho = resHm1/max(rhoL2Now, 1e-30);

// Disabled expensive diagnostics for speed.
poissonRelL2 = 0.0;
poissonRelH1 = 0.0;
strongResL2 = 0.0;
strongResRelEnergy = 0.0;
strongResRelRho = 0.0;
strongResMaxAbs = 0.0;
defectL2Now = 0.0;
gradRhoL2Now = 0.0;
normalizedDefectNow = 0.0;

JNow = 0.5*int2d(Th)(dx(u)^2 + dy(u)^2) - int2d(Th)(Ffun(u));

activeAreaNow = int2d(Th)(activeFinal);
plateauAreaNow = int2d(Th)(plateauFinal);
plateauFracNow = plateauAreaNow/max(activeAreaNow, 1e-30);

relRhoDesignNow = sqrt(int2d(Th)((rhoFromPhi-rhoDesign)^2))/max(rhoDesignL2, 1e-30);

metricsTimeNow = clock()-tMetrics;


cout
	<< "FINAL "
	<< "resH-1=" << resHm1
	<< " maxPhi=" << u[].max
	<< " maxRho=" << rhoFromPhi[].max
	<< " mass=" << int2d(Th)(rhoFromPhi)
	<< " relDesign=" << relRhoDesignNow
	<< endl;

humanlog
	<< "FINAL "
	<< "resEuclid=" << resEuclid << " "
	<< "resHm1=" << resHm1 << " "
	<< "resHm1RelEnergy=" << resHm1RelEnergy << " "
	<< "resHm1RelRho=" << resHm1RelRho << " "
	<< "poissonRelL2=" << poissonRelL2 << " "
	<< "poissonRelH1=" << poissonRelH1 << " "
	<< "strongResL2=" << strongResL2 << " "
	<< "strongResRelEnergy=" << strongResRelEnergy << " "
	<< "strongResRelRho=" << strongResRelRho << " "
	<< "strongResMaxAbs=" << strongResMaxAbs << " "
	<< "minPhi=" << u[].min << " "
	<< "maxPhi=" << u[].max << " "
	<< "c1Phi=" << c1Phi << " "
	<< "c2Phi=" << c2Phi << " "
	<< "epsPhi=" << epsPhi << " "
	<< "maxRho=" << rhoFromPhi[].max << " "
	<< "massRho=" << int2d(Th)(rhoFromPhi) << " "
	<< "relRhoDesign=" << relRhoDesignNow << " "
	<< "annularCheckMaxPhiMinusC2=" << u[].max-c2Phi << " "
	<< "normalizedDefect=" << normalizedDefectNow << " "
	<< "J=" << JNow
	<< endl;

humanlog
	<< "FINAL_BAND "
	<< "activeArea=" << activeAreaNow << " "
	<< "plateauArea=" << plateauAreaNow << " "
	<< "plateauFraction=" << plateauFracNow
	<< endl;

csvlog
	<< "FINAL" << ","
	<< runTag << ","
	<< "NA,NA,"
	<< epsPhi << ","
	<< "NA,"
	<< Th.nt << ","
	<< Vh.ndof << ","
	<< resEuclid << ","
	<< resHm1 << ","
	<< resHm1RelEnergy << ","
	<< resHm1RelRho << ","
	<< poissonRelL2 << ","
	<< poissonRelH1 << ","
		<< strongResL2 << ","
		<< strongResRelEnergy << ","
		<< strongResRelRho << ","
		<< strongResMaxAbs << ","
	<< "NA,NA,NA,"
	<< muShift << ","
	<< u[].min << ","
	<< u[].max << ","
	<< rhoFromPhi[].max << ","
	<< int2d(Th)(rhoFromPhi) << ","
	<< rhoL2Now << ","
	<< energyPhiNow << ","
	<< JNow << ","
	<< activeAreaNow << ","
	<< plateauAreaNow << ","
	<< plateauFracNow << ","
	<< relRhoDesignNow << ","
	<< u[].max-c2Phi << ","
	<< defectL2Now << ","
	<< normalizedDefectNow << ","
	<< gradRhoL2Now << ","
	<< "NA,NA,"
	<< "FINAL"
	<< endl;

summary
	<< "runTag " << runTag << endl
	<< "meshFile " << meshFile << endl
	<< "nt " << Th.nt << endl
	<< "ndof " << Vh.ndof << endl
	<< "alphaT1 " << alphaT1 << endl
	<< "alphaT2 " << alphaT2 << endl
	<< "epsTRatio " << epsTRatio << endl
	<< "betaPhi1 " << betaPhi1 << endl
	<< "betaPhi2 " << betaPhi2 << endl
	<< "c1Phi " << c1Phi << endl
	<< "c2Phi " << c2Phi << endl
	<< "epsPhi " << epsPhi << endl
	<< "resEuclid " << resEuclid << endl
	<< "resHm1 " << resHm1 << endl
	<< "resHm1RelEnergy " << resHm1RelEnergy << endl
	<< "resHm1RelRho " << resHm1RelRho << endl
	<< "massRho " << int2d(Th)(rhoFromPhi) << endl
	<< "maxRho " << rhoFromPhi[].max << endl
	<< "activeArea " << activeAreaNow << endl
	<< "plateauArea " << plateauAreaNow << endl
	<< "plateauFrac " << plateauFracNow << endl
	<< "relRhoDesign " << relRhoDesignNow << endl
	<< "annularPhiMinusC2 " << u[].max-c2Phi << endl
	<< "normalizedDefect " << normalizedDefectNow << endl
	<< "J " << JNow << endl
	<< "timeTotal " << clock()-tGlobal << endl;

if (plt == 1 && plotFinal == 1)
{
	plot(T, fill=true, value=true, wait=true, nbiso=60,
		cmm="Torsion T");

	plot(Th, rhoDesign, fill=true, value=true, wait=true, nbiso=60,
		cmm="Designed rhoDesign = g_T(T), mesh overlay");

	plot(phiDesign, fill=true, value=true, wait=true, nbiso=60,
		cmm="Poisson initializer phiDesign");

	plot(u, fill=true, value=true, wait=true, nbiso=60,
		cmm="Final semilinear phi");

	plot(Th, rhoFromPhi, fill=true, value=true, wait=true, nbiso=60,
		cmm="Final semilinear rho=f(phi), mesh overlay");

}

// ----------------------------
// Save fields for simulation.
// ----------------------------
savemesh(Th, outMesh);

{
	ofstream frho(outRhoDof);
	frho << rhoFromPhi[];
}

{
	ofstream fphi(outPhiDof);
	fphi << u[];
}

savevtk(outVTK, Th, T, rhoDesign, phiDesign, u, rhoFromPhi, gradTNorm,
	dataname="T rhoDesign phiDesign phiFinal rhoFinal gradTNorm");

cout << "EXPORT mesh=" << outMesh << " rho=" << outRhoDof << " phi=" << outPhiDof << " vtk=" << outVTK << endl;
cout << "TIME_TOTAL " << clock()-tGlobal << endl;
cout << "========== END STRATEGY A ADAPTIVE TORSION NEWTON ==========" << endl;

humanlog << "EXPORT mesh=" << outMesh << " rho=" << outRhoDof << " phi=" << outPhiDof << " vtk=" << outVTK << endl;
humanlog << "TIME_TOTAL " << clock()-tGlobal << endl;
humanlog << "END runTag=" << runTag << endl;
