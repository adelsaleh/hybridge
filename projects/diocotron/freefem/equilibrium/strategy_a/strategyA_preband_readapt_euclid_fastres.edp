				<< nd << ","
				<< alpha << ","
				<< nBacktrack << ","
				<< muShift << ","
				<< u[].min << ","
				<< u[].max << ","
				<< rhoFromPhi[].max << ","
				<< int2d(Th)(rhoFromPhi) << ","
				<< rhoL2Now << ","
				<< energyPhiNow << ","
				<< JNow << ","
				<< activeAreaNow << ","
				<< plateauAreaNow << ","
				<< plateauFracNow << ","
				<< relRhoDesignNow << ","
				<< u[].max-c2Phi << ","
				<< defectL2Now << ","
				<< normalizedDefectNow << ","
				<< gradRhoL2Now << ","
				<< newtonSolveTime << ","
				<< metricsTimeNow << ","
				<< clock()-tStep << ","
				<< "FAIL_LS"
				<< endl;
						cout
				<< "STEP "
				<< "ieps=" << ieps
				<< " k=" << k
				<< " resE=" << resEuclid
				<< " alpha=" << alpha
				<< " bt=" << nBacktrack
				<< " mu=" << muShift
				<< " maxU=" << u[].max
				<< " maxRho=" << rhoFromPhi[].max
				<< " mass=" << int2d(Th)(rhoFromPhi)
				<< " relDesign=" << relRhoDesignNow
				<< " solveT=" << newtonSolveTime
				<< " metricT=" << metricsTimeNow
				<< " stepT=" << clock()-tStep
				<< " status=FAIL_LS"
				<< endl;

			muShift = min(muMax, 2.0*muShift);

			humanlog
				<< "SHIFT "
				<< "ieps=" << ieps << " "
				<< "k=" << k << " "
				<< "newMu=" << muShift << " "
				<< "reason=fail_ls"
				<< endl;

			rejectCount++;

			if (rejectCount >= 5 || muShift >= muMax)
			{
				cout << "EPS_STOP ieps=" << ieps << " reason=too_many_failed_steps" << endl;
				humanlog << "EPS_STOP ieps=" << ieps << " reason=too_many_failed_steps" << endl;
				break;
			}

			continue;
		}

		rejectCount = 0;

		if (nBacktrack <= 1)
		{
			muShift = max(muMin, 0.85*muShift);
		}
		else if (nBacktrack >= 8)
		{
			muShift = min(muMax, 1.5*muShift);
		}

		real relDrop = abs(resOld-res)/max(resOld, 1e-30);

		if (relDrop < stagnationTol)
		{
			stagnationCount++;
			muShift = min(muMax, 1.25*muShift);

			humanlog
				<< "SHIFT "
				<< "ieps=" << ieps << " "
				<< "k=" << k << " "
				<< "newMu=" << muShift << " "
				<< "reason=stagnation"
				<< endl;

			if (stagnationCount >= maxStagnation)
			{
				cout << "EPS_STOP ieps=" << ieps << " reason=repeated_stagnation" << endl;
				humanlog << "EPS_STOP ieps=" << ieps << " reason=repeated_stagnation" << endl;
				break;
			}
		}
		else
		{
			stagnationCount = 0;
		}

		if (plotDuringNewton == 1 && k % 5 == 0)
		{
			plot(u, fill=true, value=true, wait=false, nbiso=50,
				cmm="Newton iterate u");

			rhoFromPhi = ffun(u);
			plot(Th, rhoFromPhi, fill=true, value=true, wait=false, nbiso=50,
				cmm="Newton rho=f(u) with mesh overlay, eps=" + epsPhiRatio + ", resE=" + resEuclid);
		}
	}

	/* inline ComputeFastMetrics */
tMetrics = clock();
rhoFromPhi = ffun(u);
activeFinal = (rhoFromPhi > activeThreshold*rhoAmp);
plateauFinal = (rhoFromPhi > plateauThreshold*rhoAmp);

rr.resize(Vh.ndof);
rr = 0.0;
rr = ResidualForm(0, Vh);
resEuclid = sqrt(rr'*rr);

// H^{-1}_h residual disabled for speed.
// resEuclid is now the only Newton/Armijo residual metric.
resHm1 = 0.0;

rhoL2Now = sqrt(int2d(Th)(rhoFromPhi^2));
energyPhiNow = sqrt(int2d(Th)(dx(u)^2 + dy(u)^2));

resHm1RelEnergy = 0.0;
resHm1RelRho = 0.0;

// Disabled expensive diagnostics for speed.
poissonRelL2 = 0.0;
poissonRelH1 = 0.0;
strongResL2 = 0.0;
strongResRelEnergy = 0.0;
strongResRelRho = 0.0;
strongResMaxAbs = 0.0;
defectL2Now = 0.0;
gradRhoL2Now = 0.0;
normalizedDefectNow = 0.0;

JNow = 0.5*int2d(Th)(dx(u)^2 + dy(u)^2) - int2d(Th)(Ffun(u));

activeAreaNow = int2d(Th)(activeFinal);
plateauAreaNow = int2d(Th)(plateauFinal);
plateauFracNow = plateauAreaNow/max(activeAreaNow, 1e-30);

relRhoDesignNow = sqrt(int2d(Th)((rhoFromPhi-rhoDesign)^2))/max(rhoDesignL2, 1e-30);

metricsTimeNow = clock()-tMetrics;


	cout
		<< "EPS_END "
		<< "ieps=" << ieps
		<< " resE=" << resEuclid
		<< " mass=" << int2d(Th)(rhoFromPhi)
		<< " maxRho=" << rhoFromPhi[].max
		<< endl;

	humanlog
		<< "EPS_END "
		<< "ieps=" << ieps << " "
		<< "epsPhiRatio=" << epsPhiRatio << " "
		<< "epsPhi=" << epsPhi << " "
		<< "minU=" << u[].min << " "
		<< "maxU=" << u[].max << " "
		<< "maxRho=" << rhoFromPhi[].max << " "
		<< "massRho=" << int2d(Th)(rhoFromPhi) << " "
		<< "relRhoDesign=" << relRhoDesignNow << " "
		<< "annularPhiMinusC2=" << u[].max-c2Phi << " "
		<< "resHm1Disabled=" << resHm1 << " "
		<< endl;

	csvlog
		<< "EPS_END" << ","
		<< runTag << ","
		<< ieps << ","
		<< epsPhiRatio << ","
		<< epsPhi << ","
		<< "NA,"
		<< Th.nt << ","
		<< Vh.ndof << ","
		<< resEuclid << ","
		<< resHm1 << ","
		<< resHm1RelEnergy << ","
		<< resHm1RelRho << ","
		<< poissonRelL2 << ","
		<< poissonRelH1 << ","
		<< strongResL2 << ","
		<< strongResRelEnergy << ","
		<< strongResRelRho << ","
		<< strongResMaxAbs << ","
		<< "NA,NA,NA,"
		<< muShift << ","
		<< u[].min << ","
		<< u[].max << ","
		<< rhoFromPhi[].max << ","
		<< int2d(Th)(rhoFromPhi) << ","
		<< rhoL2Now << ","
		<< energyPhiNow << ","
		<< JNow << ","
		<< activeAreaNow << ","
		<< plateauAreaNow << ","
		<< plateauFracNow << ","
		<< relRhoDesignNow << ","
		<< u[].max-c2Phi << ","
		<< defectL2Now << ","
		<< normalizedDefectNow << ","
		<< gradRhoL2Now << ","
		<< "NA,NA,NA,"
		<< "EPS_END"
		<< endl;

	// ------------------------------------------------------------
	// Mesh adaptation between continuation stages.
	// ------------------------------------------------------------
	if (useAdaptMesh == 1 && (ieps < nEpsPhi-1 || adaptAfterLastEps == 1))
	{
		// Decide whether readaptation is useful. We compare the present active
		// band against the band at the last successful adaptation.
		rhoFromPhi = ffun(u);
		activeFinal = (rhoFromPhi > activeThreshold*rhoAmp);
		plateauFinal = (rhoFromPhi > plateauThreshold*rhoAmp);

		real activeAreaBeforeAdapt = int2d(Th)(activeFinal);
		real activeXBeforeAdapt = int2d(Th)(x*activeFinal)/max(activeAreaBeforeAdapt, 1e-30);
		real activeYBeforeAdapt = int2d(Th)(y*activeFinal)/max(activeAreaBeforeAdapt, 1e-30);
		real rhoMassBeforeAdapt = int2d(Th)(rhoFromPhi);
		real rhoMaxBeforeAdapt = rhoFromPhi[].max;
		real energyBeforeAdapt = sqrt(int2d(Th)(dx(u)^2 + dy(u)^2));

		real activeDrift = sqrt(
			(activeXBeforeAdapt-lastAdaptActiveX)^2
			+ (activeYBeforeAdapt-lastAdaptActiveY)^2
		);
		real activeAreaRelSinceAdapt = abs(activeAreaBeforeAdapt-lastAdaptActiveArea)/max(abs(lastAdaptActiveArea), 1e-30);
		real massRelSinceAdapt = abs(rhoMassBeforeAdapt-lastAdaptMass)/max(abs(lastAdaptMass), 1e-30);
		real relDesignJump = abs(relRhoDesignNow-lastAdaptRelDesign)/max(abs(lastAdaptRelDesign), 1e-30);

		int adaptNeeded = 0;
		if (adaptPolicy == 0)
			adaptNeeded = 1;
		if (activeDrift > adaptTriggerDrift)
			adaptNeeded = 1;
		if (activeAreaRelSinceAdapt > adaptTriggerAreaRel)
			adaptNeeded = 1;
		if (massRelSinceAdapt > adaptTriggerMassRel)
			adaptNeeded = 1;
		if (relDesignJump > adaptTriggerRelDesignRel)
			adaptNeeded = 1;

		cout
			<< "ADAPT_CHECK "
			<< "ieps=" << ieps
			<< " needed=" << adaptNeeded
			<< " drift=" << activeDrift
			<< " areaRel=" << activeAreaRelSinceAdapt
			<< " massRel=" << massRelSinceAdapt
			<< " relDesignJump=" << relDesignJump
			<< endl;

		humanlog
			<< "ADAPT_CHECK "
			<< "ieps=" << ieps << " "
			<< "needed=" << adaptNeeded << " "
			<< "activeDrift=" << activeDrift << " "
			<< "activeAreaRelSinceAdapt=" << activeAreaRelSinceAdapt << " "
			<< "massRelSinceAdapt=" << massRelSinceAdapt << " "
			<< "relDesignJump=" << relDesignJump << " "
			<< "activeAreaBefore=" << activeAreaBeforeAdapt << " "
			<< "activeXBefore=" << activeXBeforeAdapt << " "
			<< "activeYBefore=" << activeYBeforeAdapt
			<< endl;

		if (adaptNeeded == 0)
		{
			adaptlog
				<< "ADAPT_SKIP" << ","
				<< runTag << ","
				<< ieps << ","
				<< Th.nt << ","
				<< Vh.ndof << ","
				<< Th.nt << ","
				<< Vh.ndof << ","
				<< epsPhi << ","
				<< 0.0 << ","
				<< 0.0 << ","
				<< 0.0 << ","
				<< adaptHMax << ","
				<< adaptErr << ","
				<< adaptErrG << ","
				<< adaptRatio << ","
				<< adaptAnisoMax << ","
				<< rhoMassBeforeAdapt << ","
				<< rhoMaxBeforeAdapt << ","
				<< rhoMassBeforeAdapt << ","
				<< rhoMaxBeforeAdapt << ","
				<< 0.0 << ","
				<< 0.0 << ","
				<< activeAreaBeforeAdapt << ","
				<< activeAreaBeforeAdapt << ","
				<< 0.0 << ","
				<< energyBeforeAdapt << ","
				<< energyBeforeAdapt << ","
				<< 0.0 << ","
				<< activeDrift << ","
				<< relDesignJump << ","
				<< 0 << ","
				<< 1.0 << ","
				<< adaptNeeded << ","
				<< 0 << ","
				<< 0.0 << ","
				<< "SKIP"
				<< endl;
		}
		else
		{
			tAdapt = clock();
			gradPhiMag = sqrt(dx(u)^2 + dy(u)^2);

			real maxGradPhi = gradPhiMag[].max;
			real hTarget = adaptSafety*epsPhi/max(maxGradPhi, 1e-12);
			real hMinUsed = max(adaptHMin, min(adaptHMax, hTarget));
			real ntOld = Th.nt;
			real ndofOld = Vh.ndof;

			if (plt == 1 && plotAdaptOverlay == 1)
			{
				plot(Th, rhoFromPhi, fill=true, value=true, wait=false, nbiso=60,
					cmm="Before adapt: rho=f(u) with mesh overlay");
			}

			cout
				<< "ADAPT_START "
				<< "ieps=" << ieps
				<< " nt=" << ntOld
				<< " ndof=" << ndofOld
				<< " hMinUsed=" << hMinUsed
				<< " hMax=" << adaptHMax
				<< " errBase=" << adaptErr
				<< " coarseSearch=" << adaptCoarseSearch
				<< endl;

			int adaptTry = 0;
			int adaptAccepted = 0;
			real adaptSearchScale = adaptSearchScale0;
			if (adaptCoarseSearch == 0)
				adaptSearchScale = 1.0;

			real ntNew = ntOld;
			real ndofNew = ndofOld;
			real rhoMassAfterAdapt = rhoMassBeforeAdapt;
			real rhoMaxAfterAdapt = rhoMaxBeforeAdapt;
			real activeAreaAfterAdapt = activeAreaBeforeAdapt;
			real energyAfterAdapt = energyBeforeAdapt;
			real massRelChange = 0.0;
			real maxRhoRelChange = 0.0;
			real activeAreaRelChange = 0.0;
			real energyRelChange = 0.0;
			real errTry = adaptErr;
			real errgTry = adaptErrG;
			real adaptTime = 0.0;

			while (adaptTry < adaptSearchMax && adaptAccepted == 0)
			{
				errTry = adaptErr*adaptSearchScale;
				errgTry = adaptErrG*adaptSearchScale;

				// Keep a copy of the current fields for interpolation onto the new mesh.
				uOld = u;
				uTrial = u;
				tmp = rhoFromPhi;

				Th = adaptmesh(
					Th,
					rhoFromPhi,
					u,
					err=errTry,
					errg=errgTry,
					hmin=hMinUsed,
					hmax=adaptHMax,
					nbvx=adaptNbVx,
					ratio=adaptRatio,
					anisomax=adaptAnisoMax,
					nbsmooth=adaptNbSmooth,
					verbosity=adaptVerbosity
				);

				// Important: interpolate/rebind all FE functions after adaptmesh.
				T = T;
				phiDesign = phiDesign;
				rhoDesign = rhoDesign;
				u = uOld;
				du = 0;
				uTrial = u;
				uOld = u;
				rhoFromPhi = ffun(u);
				gradTNorm = sqrt(dx(T)^2 + dy(T)^2);
				activeDesign = (rhoDesign > activeThreshold*rhoAmp);
				plateauDesign = (rhoDesign > plateauThreshold*rhoAmp);
				activeFinal = (rhoFromPhi > activeThreshold*rhoAmp);
				plateauFinal = (rhoFromPhi > plateauThreshold*rhoAmp);

				tmp = 0.0;
				phiCheck = 0.0;
				zHminus = 0.0;

				rhoDesignMass = int2d(Th)(rhoDesign);
				rhoDesignL2 = sqrt(int2d(Th)(rhoDesign^2));
				phiDesignMax = phiDesign[].max;
				phiDesignMin = phiDesign[].min;

				ntNew = Th.nt;
				ndofNew = Vh.ndof;
				rhoMassAfterAdapt = int2d(Th)(rhoFromPhi);
				rhoMaxAfterAdapt = rhoFromPhi[].max;
				activeAreaAfterAdapt = int2d(Th)(activeFinal);
				energyAfterAdapt = sqrt(int2d(Th)(dx(u)^2 + dy(u)^2));

				massRelChange = abs(rhoMassAfterAdapt-rhoMassBeforeAdapt)/max(abs(rhoMassBeforeAdapt), 1e-30);
				maxRhoRelChange = abs(rhoMaxAfterAdapt-rhoMaxBeforeAdapt)/max(abs(rhoMaxBeforeAdapt), 1e-30);
				activeAreaRelChange = abs(activeAreaAfterAdapt-activeAreaBeforeAdapt)/max(abs(activeAreaBeforeAdapt), 1e-30);
				energyRelChange = abs(energyAfterAdapt-energyBeforeAdapt)/max(abs(energyBeforeAdapt), 1e-30);

				if (
					massRelChange <= adaptMassTol
					&& activeAreaRelChange <= adaptAreaTol
					&& energyRelChange <= adaptEnergyTol
				)
				{
					adaptAccepted = 1;
				}

				adaptTime = clock()-tAdapt;

				cout
					<< "ADAPT_TRY "
					<< "ieps=" << ieps
					<< " try=" << adaptTry
					<< " scale=" << adaptSearchScale
					<< " ntNew=" << ntNew
					<< " massRel=" << massRelChange
					<< " areaRel=" << activeAreaRelChange
					<< " energyRel=" << energyRelChange
					<< " accepted=" << adaptAccepted
					<< endl;

				adaptlog
					<< "ADAPT_TRY" << ","
					<< runTag << ","
					<< ieps << ","
					<< ntOld << ","
					<< ndofOld << ","
					<< ntNew << ","
					<< ndofNew << ","
					<< epsPhi << ","
					<< maxGradPhi << ","
					<< hTarget << ","
					<< hMinUsed << ","
					<< adaptHMax << ","
					<< errTry << ","
					<< errgTry << ","
					<< adaptRatio << ","
					<< adaptAnisoMax << ","
					<< rhoMassBeforeAdapt << ","
					<< rhoMaxBeforeAdapt << ","
					<< rhoMassAfterAdapt << ","
					<< rhoMaxAfterAdapt << ","
					<< massRelChange << ","
					<< maxRhoRelChange << ","
					<< activeAreaBeforeAdapt << ","
					<< activeAreaAfterAdapt << ","
					<< activeAreaRelChange << ","
					<< energyBeforeAdapt << ","
					<< energyAfterAdapt << ","
					<< energyRelChange << ","
					<< activeDrift << ","
					<< relDesignJump << ","
					<< adaptTry << ","
					<< adaptSearchScale << ","
					<< adaptNeeded << ","
					<< adaptAccepted << ","
					<< adaptTime << ","
					<< "TRY"
					<< endl;

				if (adaptAccepted == 0)
				{
					adaptSearchScale = adaptSearchScale*adaptSearchFactor;
				}

				adaptTry++;
			}

			if (adaptAccepted == 0)
			{
				cout
					<< "ADAPT_WARN "
					<< "ieps=" << ieps
					<< " reason=tolerances_not_met_using_finest_attempt"
					<< " massRel=" << massRelChange
					<< " areaRel=" << activeAreaRelChange
					<< " energyRel=" << energyRelChange
					<< endl;
			}

			// Update last-adaptation reference to the current mesh/state.
			activeFinal = (rhoFromPhi > activeThreshold*rhoAmp);
			lastAdaptActiveArea = int2d(Th)(activeFinal);
			lastAdaptActiveX = int2d(Th)(x*activeFinal)/max(lastAdaptActiveArea, 1e-30);
			lastAdaptActiveY = int2d(Th)(y*activeFinal)/max(lastAdaptActiveArea, 1e-30);
			lastAdaptMass = int2d(Th)(rhoFromPhi);
			lastAdaptEnergy = sqrt(int2d(Th)(dx(u)^2 + dy(u)^2));
			lastAdaptRelDesign = sqrt(int2d(Th)((rhoFromPhi-rhoDesign)^2))/max(rhoDesignL2, 1e-30);

			adaptTime = clock()-tAdapt;

			cout
				<< "ADAPT_DONE "
				<< "ieps=" << ieps
				<< " ntNew=" << ntNew
				<< " ndofNew=" << ndofNew
				<< " massRelChange=" << massRelChange
				<< " activeAreaRelChange=" << activeAreaRelChange
				<< " energyRelChange=" << energyRelChange
				<< " accepted=" << adaptAccepted
				<< " time=" << adaptTime
				<< endl;

			humanlog
				<< "ADAPT_DONE "
				<< "ieps=" << ieps << " "
				<< "ntOld=" << ntOld << " "
				<< "ndofOld=" << ndofOld << " "
				<< "ntNew=" << ntNew << " "
				<< "ndofNew=" << ndofNew << " "
				<< "epsPhi=" << epsPhi << " "
				<< "maxGradPhi=" << maxGradPhi << " "
				<< "hTarget=" << hTarget << " "
				<< "hMinUsed=" << hMinUsed << " "
				<< "hMax=" << adaptHMax << " "
				<< "errFinal=" << errTry << " "
				<< "rhoMassAfter=" << rhoMassAfterAdapt << " "
				<< "rhoMaxAfter=" << rhoMaxAfterAdapt << " "
				<< "massRelChange=" << massRelChange << " "
				<< "activeAreaRelChange=" << activeAreaRelChange << " "
				<< "energyRelChange=" << energyRelChange << " "
				<< "accepted=" << adaptAccepted << " "
				<< "time=" << adaptTime
				<< endl;

			adaptlog
				<< "ADAPT" << ","
				<< runTag << ","
				<< ieps << ","
				<< ntOld << ","
				<< ndofOld << ","
				<< ntNew << ","
				<< ndofNew << ","
				<< epsPhi << ","
				<< maxGradPhi << ","
				<< hTarget << ","
				<< hMinUsed << ","
				<< adaptHMax << ","
				<< errTry << ","
				<< errgTry << ","
				<< adaptRatio << ","
				<< adaptAnisoMax << ","
				<< rhoMassBeforeAdapt << ","
				<< rhoMaxBeforeAdapt << ","
				<< rhoMassAfterAdapt << ","
				<< rhoMaxAfterAdapt << ","
				<< massRelChange << ","
				<< maxRhoRelChange << ","
				<< activeAreaBeforeAdapt << ","
				<< activeAreaAfterAdapt << ","
				<< activeAreaRelChange << ","
				<< energyBeforeAdapt << ","
				<< energyAfterAdapt << ","
				<< energyRelChange << ","
				<< activeDrift << ","
				<< relDesignJump << ","
				<< adaptTry-1 << ","
				<< adaptSearchScale << ","
				<< adaptNeeded << ","
				<< adaptAccepted << ","
				<< adaptTime << ","
				<< "ADAPT_DONE"
				<< endl;

			if (plt == 1 && plotAdaptOverlay == 1)
			{
				plot(Th, rhoFromPhi, fill=true, value=true, wait=false, nbiso=60,
					cmm="After adapt: rho=f(u) with adapted mesh overlay");
			}

			savevtk(vtkDir + "/" + runTag + "_adapt_stage_" + ieps + ".vtu", Th, u, rhoFromPhi, rhoDesign, phiDesign,
				dataname="phi rho rhoDesign phiDesign");
		}
	}

}

// ----------------------------
// Final solution and diagnostics
// ----------------------------
/* inline ComputeFastMetrics */
tMetrics = clock();
rhoFromPhi = ffun(u);
activeFinal = (rhoFromPhi > activeThreshold*rhoAmp);
plateauFinal = (rhoFromPhi > plateauThreshold*rhoAmp);

rr.resize(Vh.ndof);
rr = 0.0;
rr = ResidualForm(0, Vh);
resEuclid = sqrt(rr'*rr);

// H^{-1}_h residual disabled for speed.
// resEuclid is now the only Newton/Armijo residual metric.
resHm1 = 0.0;

rhoL2Now = sqrt(int2d(Th)(rhoFromPhi^2));
energyPhiNow = sqrt(int2d(Th)(dx(u)^2 + dy(u)^2));

resHm1RelEnergy = 0.0;
resHm1RelRho = 0.0;

// Disabled expensive diagnostics for speed.
poissonRelL2 = 0.0;
poissonRelH1 = 0.0;
strongResL2 = 0.0;
strongResRelEnergy = 0.0;
strongResRelRho = 0.0;
strongResMaxAbs = 0.0;
defectL2Now = 0.0;
gradRhoL2Now = 0.0;
normalizedDefectNow = 0.0;

JNow = 0.5*int2d(Th)(dx(u)^2 + dy(u)^2) - int2d(Th)(Ffun(u));

activeAreaNow = int2d(Th)(activeFinal);
plateauAreaNow = int2d(Th)(plateauFinal);
plateauFracNow = plateauAreaNow/max(activeAreaNow, 1e-30);

relRhoDesignNow = sqrt(int2d(Th)((rhoFromPhi-rhoDesign)^2))/max(rhoDesignL2, 1e-30);

metricsTimeNow = clock()-tMetrics;


cout
	<< "FINAL "
	<< "resE=" << resEuclid
	<< " maxPhi=" << u[].max
	<< " maxRho=" << rhoFromPhi[].max
	<< " mass=" << int2d(Th)(rhoFromPhi)
	<< " relDesign=" << relRhoDesignNow
	<< endl;

humanlog
	<< "FINAL "
	<< "resEuclid=" << resEuclid << " "
	<< "resHm1Disabled=" << resHm1 << " "
	<< "resHm1RelEnergy=" << resHm1RelEnergy << " "
	<< "resHm1RelRho=" << resHm1RelRho << " "
	<< "poissonRelL2=" << poissonRelL2 << " "
	<< "poissonRelH1=" << poissonRelH1 << " "
	<< "strongResL2=" << strongResL2 << " "
	<< "strongResRelEnergy=" << strongResRelEnergy << " "
	<< "strongResRelRho=" << strongResRelRho << " "
	<< "strongResMaxAbs=" << strongResMaxAbs << " "
	<< "minPhi=" << u[].min << " "
	<< "maxPhi=" << u[].max << " "
	<< "c1Phi=" << c1Phi << " "
	<< "c2Phi=" << c2Phi << " "
	<< "epsPhi=" << epsPhi << " "
	<< "maxRho=" << rhoFromPhi[].max << " "
	<< "massRho=" << int2d(Th)(rhoFromPhi) << " "
	<< "relRhoDesign=" << relRhoDesignNow << " "
	<< "annularCheckMaxPhiMinusC2=" << u[].max-c2Phi << " "
	<< "normalizedDefect=" << normalizedDefectNow << " "
	<< "J=" << JNow
	<< endl;

humanlog
	<< "FINAL_BAND "
	<< "activeArea=" << activeAreaNow << " "
	<< "plateauArea=" << plateauAreaNow << " "
	<< "plateauFraction=" << plateauFracNow
	<< endl;

csvlog
	<< "FINAL" << ","
	<< runTag << ","
	<< "NA,NA,"
	<< epsPhi << ","
	<< "NA,"
	<< Th.nt << ","
	<< Vh.ndof << ","
	<< resEuclid << ","
	<< resHm1 << ","
	<< resHm1RelEnergy << ","
	<< resHm1RelRho << ","
	<< poissonRelL2 << ","
	<< poissonRelH1 << ","
		<< strongResL2 << ","
		<< strongResRelEnergy << ","
		<< strongResRelRho << ","
		<< strongResMaxAbs << ","
	<< "NA,NA,NA,"
	<< muShift << ","
	<< u[].min << ","
	<< u[].max << ","
	<< rhoFromPhi[].max << ","
	<< int2d(Th)(rhoFromPhi) << ","
	<< rhoL2Now << ","
	<< energyPhiNow << ","
	<< JNow << ","
	<< activeAreaNow << ","
	<< plateauAreaNow << ","
	<< plateauFracNow << ","
	<< relRhoDesignNow << ","
	<< u[].max-c2Phi << ","
	<< defectL2Now << ","
	<< normalizedDefectNow << ","
	<< gradRhoL2Now << ","
	<< "NA,NA,"
	<< "FINAL"
	<< endl;

summary
	<< "runTag " << runTag << endl
	<< "meshFile " << meshFile << endl
	<< "nt " << Th.nt << endl
	<< "ndof " << Vh.ndof << endl
	<< "alphaT1 " << alphaT1 << endl
	<< "alphaT2 " << alphaT2 << endl
	<< "epsTRatio " << epsTRatio << endl
	<< "betaPhi1 " << betaPhi1 << endl
	<< "betaPhi2 " << betaPhi2 << endl
	<< "c1Phi " << c1Phi << endl
	<< "c2Phi " << c2Phi << endl
	<< "epsPhi " << epsPhi << endl
	<< "resEuclid " << resEuclid << endl
	<< "resHm1 " << resHm1 << endl
	<< "resHm1RelEnergy " << resHm1RelEnergy << endl
	<< "resHm1RelRho " << resHm1RelRho << endl
	<< "massRho " << int2d(Th)(rhoFromPhi) << endl
	<< "maxRho " << rhoFromPhi[].max << endl
	<< "activeArea " << activeAreaNow << endl
	<< "plateauArea " << plateauAreaNow << endl
	<< "plateauFrac " << plateauFracNow << endl
	<< "relRhoDesign " << relRhoDesignNow << endl
	<< "annularPhiMinusC2 " << u[].max-c2Phi << endl
	<< "normalizedDefect " << normalizedDefectNow << endl
	<< "J " << JNow << endl
	<< "timeTotal " << clock()-tGlobal << endl;

if (plt == 1 && plotFinal == 1)
{
	plot(T, fill=true, value=true, wait=true, nbiso=60,
		cmm="Torsion T");

	plot(Th, rhoDesign, fill=true, value=true, wait=true, nbiso=60,
		cmm="Designed rhoDesign = g_T(T), mesh overlay");

	plot(phiDesign, fill=true, value=true, wait=true, nbiso=60,
		cmm="Poisson initializer phiDesign");

	plot(u, fill=true, value=true, wait=true, nbiso=60,
		cmm="Final semilinear phi");

	plot(Th, rhoFromPhi, fill=true, value=true, wait=true, nbiso=60,
		cmm="Final semilinear rho=f(phi), mesh overlay");

}

// ----------------------------
// Save fields for simulation.
// ----------------------------
savemesh(Th, outMesh);

{
	ofstream frho(outRhoDof);
	frho << rhoFromPhi[];
}

{
	ofstream fphi(outPhiDof);
	fphi << u[];
}

savevtk(outVTK, Th, T, rhoDesign, phiDesign, u, rhoFromPhi, gradTNorm,
	dataname="T rhoDesign phiDesign phiFinal rhoFinal gradTNorm");

cout << "EXPORT mesh=" << outMesh << " rho=" << outRhoDof << " phi=" << outPhiDof << " vtk=" << outVTK << endl;
cout << "TIME_TOTAL " << clock()-tGlobal << endl;
cout << "========== END STRATEGY A ADAPTIVE TORSION NEWTON ==========" << endl;

humanlog << "EXPORT mesh=" << outMesh << " rho=" << outRhoDof << " phi=" << outPhiDof << " vtk=" << outVTK << endl;
humanlog << "TIME_TOTAL " << clock()-tGlobal << endl;
humanlog << "END runTag=" << runTag << endl;
