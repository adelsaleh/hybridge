// ================================================================
// Strategy A with fitted phi-window:
// torsion-designed initializer + semilinear Newton.
//
// 1. Solve torsion potential T:
//      -Delta T = 1, T=0 on boundary.
//
// 2. Build a designed localized band:
//      rhoDesign = g_T(T)
//                = sigma_T(T-c1T) - sigma_T(T-c2T).
//
// 3. Compute Poisson-consistent initializer:
//      -Delta phiDesign = rhoDesign, phiDesign=0.
//
// 4. Define a semilinear nonlinearity in phi-space:
//      f(phi) = sigma_phi(phi-c1Phi) - sigma_phi(phi-c2Phi),
//      with c1Phi,c2Phi fitted from phiDesign values on the
//      designed band/plateau of rhoDesign.
//
// 5. Newton solve:
//      -Delta u = f(u), u=0 on boundary,
//      initialized by phiDesign.
//
// This is still a fixed logistic-window semilinear solve, but the
// window is fitted to the designed density location instead of using
// arbitrary fractions of max(phiDesign).
// ================================================================

load "gmsh"
load "iovtk"

// ----------------------------
// Parameters
// ----------------------------
int bLabel = 1;
int plt = 1;
int plotDuringNewton = 1;
int verboseLS = 0;

//string meshFile = "iter_wall.mesh";
string meshFile = "iter.msh";

// Torsion-designed band parameters.
real alphaT1 = 0.80;
real alphaT2 = 0.85;
real epsTRatio = 0.15;
real rhoAmp = 1.0;

// Fitted semilinear window parameters.
// activeCutFraction: broad support diagnostic for rhoDesign.
// plateauCutFraction: used to fit c1Phi,c2Phi from phiDesign values.
// fitPad: expands the plateau phi-range.
real activeCutFraction = 0.15;
real plateauCutFraction = 0.85;
real fitPad = 0.20;

// If the plateau phi range is too small, fallback to active range.
real minPhiBandWidth = 1e-12;

// Continuation in epsilon for the semilinear f(phi).
int nEpsPhi = 4;
real[int] epsPhiRatioList(nEpsPhi);
epsPhiRatioList[0] = 0.28;
epsPhiRatioList[1] = 0.20;
epsPhiRatioList[2] = 0.14;
epsPhiRatioList[3] = 0.10;

// Newton parameters.
int maxIt = 70;
real tolRes = 1e-8;
real tolNewton = 1e-10;
real betaLS = 0.5;
real armijoC = 1e-6;
real alphaMin = 1e-7;
int maxBacktrack = 30;

// Shifted Newton stabilization.
real muShift = 2.0;
real muMin = 0.20;
real muMax = 30.0;

// Branch preservation: only prevent collapse. Do not force annularity.
real massFloorFraction = 0.01;
real rhoMaxFloor = 0.02;

// Repeated stagnation stop.
int maxStagnation = 5;
real stagnationTol = 1e-5;

// Outputs.
string outMesh = "equilibrium_mesh.msh";
string outRhoDof = "rho_dof.txt";
string outPhiDof = "phi_dof.txt";
string outVTK = "strategyA_fitted_window_newton.vtu";

// ----------------------------
// Timing
// ----------------------------
real tGlobal = clock();
real tBlock;
real tSolve;
real tResidual;

cout << endl;
cout << "========== START STRATEGY A FITTED-WINDOW NEWTON ==========" << endl;
cout << "HYBRID_HEADER "
<< "ieps epsPhiRatio epsPhi k res nd alpha bt muShift "
<< "minU maxU maxRho massRho relRhoDesign annularPhiMinusC2 status"
<< endl;

// ----------------------------
// Mesh and FE spaces
// ----------------------------
tBlock = clock();
mesh Th = gmshload(meshFile);
cout << "MESH nt=" << Th.nt << " loadTime=" << clock()-tBlock << endl;

tBlock = clock();
fespace Vh(Th, P2);
Vh T, phiDesign, rhoDesign, rhoFromPhi;
Vh u, du, v, uTrial, uOld, tmp;
Vh defectDesign, defectFinal, gradTNorm;
Vh activeDesign, plateauDesign, activeFinal, plateauFinal;
cout << "SPACE ndof=" << Vh.ndof << " allocTime=" << clock()-tBlock << endl;

// ----------------------------
// Torsion solve
// ----------------------------
problem Torsion(T, v, solver=sparsesolver)
        =
        int2d(Th)(
                        dx(T)*dx(v)
                        + dy(T)*dy(v)
                 )
        - int2d(Th)(
                        1.0*v
                   )
        + on(bLabel, T=0);

        tSolve = clock();
        Torsion;
        real torsionTime = clock()-tSolve;

        real Tmax = T[].max;
        real Tmin = T[].min;

if (Tmax <= 1e-14)
{
        cout << "ERROR Tmax_too_small check_bLabel=" << bLabel << endl;
        exec("exit 1");
}

real c1T = alphaT1*Tmax;
real c2T = alphaT2*Tmax;
real widthT = c2T-c1T;
real epsT = epsTRatio*widthT;

cout << "TORSION "
<< "Tmin=" << Tmin << " "
<< "Tmax=" << Tmax << " "
<< "alphaT1=" << alphaT1 << " "
<< "alphaT2=" << alphaT2 << " "
<< "c1T=" << c1T << " "
<< "c2T=" << c2T << " "
<< "widthT=" << widthT << " "
<< "epsTRatio=" << epsTRatio << " "
<< "epsT=" << epsT << " "
<< "time=" << torsionTime
<< endl;

// ----------------------------
// Torsion-window functions g_T
// ----------------------------
func real sigmaT(real z)
{
        real zz = z/epsT;

        if (zz > 50.0)
                return 1.0;

        if (zz < -50.0)
                return 0.0;

        return 1.0/(1.0 + exp(-zz));
}

func real gT(real s)
{
        return rhoAmp*(sigmaT(s-c1T) - sigmaT(s-c2T));
}

rhoDesign = gT(T);
if (plt == 1)
{
        plot(rhoDesign, fill=true, value=true, wait=true, nbiso=50, cmm="Design Rho");
}

gradTNorm = sqrt(dx(T)^2 + dy(T)^2);
activeDesign = (rhoDesign > 0.05*rhoAmp);
plateauDesign = (rhoDesign > 0.90*rhoAmp);

real rhoDesignMass = int2d(Th)(rhoDesign);
real rhoDesignL2 = sqrt(int2d(Th)(rhoDesign^2));

cout << "RHO_DESIGN "
<< "rhoMin=" << rhoDesign[].min << " "
<< "rhoMax=" << rhoDesign[].max << " "
<< "rhoMass=" << rhoDesignMass << " "
<< "rhoL2=" << rhoDesignL2 << " "
<< "activeArea=" << int2d(Th)(activeDesign) << " "
<< "plateauArea=" << int2d(Th)(plateauDesign) << " "
<< "plateauFraction=" << int2d(Th)(plateauDesign)/max(int2d(Th)(activeDesign), 1e-30)
<< endl;

// ----------------------------
// Poisson solve for phiDesign
// ----------------------------
varf a(uu,vv)
        =
        int2d(Th)(
                        dx(uu)*dx(vv)
                        + dy(uu)*dy(vv)
                 )
        + on(bLabel, uu=0);

varf m(uu,vv)
        =
        int2d(Th)(
                        uu*vv
                 );

        matrix K = a(Vh,Vh);
        matrix M = m(Vh,Vh);

        tmp[] = M*rhoDesign[];
        phiDesign[] = K^-1*tmp[];

        real phiDesignMax = phiDesign[].max;
        real phiDesignMin = phiDesign[].min;
        real phiDesignL2 = sqrt(int2d(Th)(phiDesign^2));
        real phiDesignEnergy = sqrt(int2d(Th)(dx(phiDesign)^2 + dy(phiDesign)^2));

        defectDesign = -dy(phiDesign)*dx(rhoDesign) + dx(phiDesign)*dy(rhoDesign);
        real defectDesignL2 = sqrt(int2d(Th)(defectDesign^2));
        real gradRhoDesignL2 = sqrt(int2d(Th)(dx(rhoDesign)^2 + dy(rhoDesign)^2));
        real normalizedDefectDesign = defectDesignL2/max(gradRhoDesignL2*phiDesignEnergy, 1e-30);

        cout << "PHI_DESIGN "
        << "phiMin=" << phiDesignMin << " "
        << "phiMax=" << phiDesignMax << " "
        << "phiL2=" << phiDesignL2 << " "
        << "energy=" << phiDesignEnergy << " "
        << "defectL2=" << defectDesignL2 << " "
        << "normalizedDefect=" << normalizedDefectDesign
        << endl;

if (phiDesignMax <= 1e-14)
{
        cout << "ERROR phiDesignMax_too_small cannot_define_phi_window" << endl;
        exec("exit 1");
}

// ----------------------------
// Fitted phi-window from phiDesign on the designed band.
// ----------------------------
real activeCut = activeCutFraction*rhoAmp;
real plateauCut = plateauCutFraction*rhoAmp;

real phiActMin = 1e100;
real phiActMax = -1e100;
real phiPlatMin = 1e100;
real phiPlatMax = -1e100;
int nAct = 0;
int nPlat = 0;

for (int i = 0; i < Vh.ndof; i++)
{
        if (rhoDesign[][i] > activeCut)
        {
                phiActMin = min(phiActMin, phiDesign[][i]);
                phiActMax = max(phiActMax, phiDesign[][i]);
                nAct++;
        }

        if (rhoDesign[][i] > plateauCut)
        {
                phiPlatMin = min(phiPlatMin, phiDesign[][i]);
                phiPlatMax = max(phiPlatMax, phiDesign[][i]);
                nPlat++;
        }
}

if (nAct <= 0)
{
        cout << "ERROR no_active_design_dofs activeCut=" << activeCut << endl;
        exec("exit 1");
}

real phiBandMin;
real phiBandMax;
string fitSource = "plateau";

if (nPlat > 0 && phiPlatMax-phiPlatMin > minPhiBandWidth)
{
        phiBandMin = phiPlatMin;
        phiBandMax = phiPlatMax;
}
else
{
        fitSource = "active";
        phiBandMin = phiActMin;
        phiBandMax = phiActMax;
}

real rawWidthPhi = phiBandMax-phiBandMin;

if (rawWidthPhi <= minPhiBandWidth)
{
        cout << "ERROR fitted_phi_window_too_small "
                << "fitSource=" << fitSource << " "
                << "rawWidthPhi=" << rawWidthPhi << endl;
        exec("exit 1");
}

real c1Phi = max(0.0, phiBandMin - fitPad*rawWidthPhi);
real c2Phi = phiBandMax + fitPad*rawWidthPhi;
real widthPhi = c2Phi-c1Phi;
real epsPhi = epsPhiRatioList[0]*widthPhi;

cout << "FITTED_WINDOW "
<< "activeCutFraction=" << activeCutFraction << " "
<< "plateauCutFraction=" << plateauCutFraction << " "
<< "fitPad=" << fitPad << " "
<< "fitSource=" << fitSource << " "
<< "nAct=" << nAct << " "
<< "nPlat=" << nPlat << " "
<< "phiActMin=" << phiActMin << " "
<< "phiActMax=" << phiActMax << " "
<< "phiPlatMin=" << phiPlatMin << " "
<< "phiPlatMax=" << phiPlatMax << " "
<< "c1Phi=" << c1Phi << " "
<< "c2Phi=" << c2Phi << " "
<< "widthPhi=" << widthPhi << " "
<< "initialEpsPhi=" << epsPhi << " "
<< "initAnnularCheck=" << phiDesignMax-c2Phi
<< endl;

// ----------------------------
// Semilinear f(phi) and derivative.
// ----------------------------
func real sigmaPhi(real z)
{
        real zz = z/epsPhi;

        if (zz > 50.0)
                return 1.0;

        if (zz < -50.0)
                return 0.0;

        return 1.0/(1.0 + exp(-zz));
}

func real sigmaPhiP(real z)
{
        real S = sigmaPhi(z);
        return S*(1.0-S)/epsPhi;
}

func real ffun(real s)
{
        return rhoAmp*(sigmaPhi(s-c1Phi) - sigmaPhi(s-c2Phi));
}

func real dffun(real s)
{
        return rhoAmp*(sigmaPhiP(s-c1Phi) - sigmaPhiP(s-c2Phi));
}

// Initial guess for Newton is the designed Poisson potential.
u = phiDesign;
rhoFromPhi = ffun(u);

real initRelRhoDesign = sqrt(int2d(Th)((rhoFromPhi-rhoDesign)^2))/max(rhoDesignL2, 1e-30);
cout << "INIT_MATCH "
<< "fPhiMin=" << rhoFromPhi[].min << " "
<< "fPhiMax=" << rhoFromPhi[].max << " "
<< "fPhiMass=" << int2d(Th)(rhoFromPhi) << " "
<< "relRhoDesign=" << initRelRhoDesign
<< endl;

// ----------------------------
// Residual and shifted Newton problem.
// ----------------------------
varf ResidualForm(unused, vv)
        =
        int2d(Th)(
                        dx(u)*dx(vv)
                        + dy(u)*dy(vv)
                        - ffun(u)*vv
                 )
        + on(bLabel, unused=0);

func real residualNorm()
{
        real[int] r = ResidualForm(0, Vh);
        return sqrt(r'*r);
}

problem NewtonStep(du, v, solver=sparsesolver)
        =
        int2d(Th)(
                        (1.0 + muShift)*(dx(du)*dx(v) + dy(du)*dy(v))
                        - dffun(u)*du*v
                 )
        + int2d(Th)(
                        dx(u)*dx(v)
                        + dy(u)*dy(v)
                        - ffun(u)*v
                   )
        + on(bLabel, du=0);

        // ================================================================
        // Continuation in epsPhi
        // ================================================================
        for (int ieps = 0; ieps < nEpsPhi; ieps++)
{
        real epsPhiRatio = epsPhiRatioList[ieps];
        epsPhi = epsPhiRatio*widthPhi;

        muShift = max(muShift, 2.0);
        rhoFromPhi = ffun(u);

        real massInitial = int2d(Th)(rhoFromPhi);
        real maxRhoInitial = rhoFromPhi[].max;
        real massFloor = massFloorFraction*max(massInitial, rhoDesignMass);
        real relRhoDesignStart = sqrt(int2d(Th)((rhoFromPhi-rhoDesign)^2))/max(rhoDesignL2, 1e-30);

        cout << "EPS_START "
                << ieps << " "
                << epsPhiRatio << " "
                << epsPhi << " "
                << c1Phi << " "
                << c2Phi << " "
                << muShift << " "
                << u[].min << " "
                << u[].max << " "
                << maxRhoInitial << " "
                << massInitial << " "
                << massFloor << " "
                << relRhoDesignStart << " "
                << u[].max-c2Phi
                << endl;

        tResidual = clock();
        real res = residualNorm();
        cout << "RES_START "
                << ieps << " "
                << res << " "
                << "time=" << clock()-tResidual
                << endl;

        int rejectCount = 0;
        int stagnationCount = 0;

        for (int k = 0; k < maxIt; k++)
        {
                tSolve = clock();
                NewtonStep;
                real newtonSolveTime = clock()-tSolve;

                real nd = sqrt(int2d(Th)(
                                        dx(du)^2 + dy(du)^2
                                        ));

                rhoFromPhi = ffun(u);
                real maxu = u[].max;
                real minu = u[].min;
                real maxrho = rhoFromPhi[].max;
                real massrho = int2d(Th)(rhoFromPhi);
                real relRhoDesign = sqrt(int2d(Th)((rhoFromPhi-rhoDesign)^2))/max(rhoDesignL2, 1e-30);

                if (res < tolRes || nd < tolNewton)
                {
                        cout << "HYBRID_LOG "
                                << ieps << " "
                                << epsPhiRatio << " "
                                << epsPhi << " "
                                << k << " "
                                << res << " "
                                << nd << " "
                                << 0 << " "
                                << 0 << " "
                                << muShift << " "
                                << minu << " "
                                << maxu << " "
                                << maxrho << " "
                                << massrho << " "
                                << relRhoDesign << " "
                                << maxu-c2Phi << " "
                                << "CONVERGED"
                                << endl;
                        break;
                }

                if (massrho < massFloor || maxrho < rhoMaxFloor)
                {
                        cout << "HYBRID_LOG "
                                << ieps << " "
                                << epsPhiRatio << " "
                                << epsPhi << " "
                                << k << " "
                                << res << " "
                                << nd << " "
                                << 0 << " "
                                << 0 << " "
                                << muShift << " "
                                << minu << " "
                                << maxu << " "
                                << maxrho << " "
                                << massrho << " "
                                << relRhoDesign << " "
                                << maxu-c2Phi << " "
                                << "RESET_TO_DESIGN"
                                << endl;

                        u = phiDesign;
                        muShift = min(muMax, 1.5*muShift);
                        rejectCount++;

                        if (rejectCount >= 5)
                        {
                                cout << "EPS_STOP " << ieps << " reason=too_many_branch_rejections" << endl;
                                break;
                        }

                        continue;
                }

                real alpha = 1.0;
                real resOld = res;
                uOld = u;
                bool accepted = false;
                int nBacktrack = 0;

                while (alpha >= alphaMin && nBacktrack <= maxBacktrack)
                {
                        uTrial = uOld + alpha*du;
                        u = uTrial;
                        rhoFromPhi = ffun(u);

                        real trialMass = int2d(Th)(rhoFromPhi);
                        real trialMaxRho = rhoFromPhi[].max;
                        real trialMaxU = u[].max;
                        real trialRelRhoDesign = sqrt(int2d(Th)((rhoFromPhi-rhoDesign)^2))/max(rhoDesignL2, 1e-30);

                        real relRhoDesignLimit = 1.25*relRhoDesignStart + 0.10;
                        bool designOK = trialRelRhoDesign <= relRhoDesignLimit; 
                        bool branchOK =
                                (trialMass >= massFloor)
                                && (trialMaxRho >= rhoMaxFloor)
                                && designOK;

                        real resNew = residualNorm();

                        if (verboseLS == 1)
                        {
                                cout << "HYBRID_LS "
                                        << "ieps=" << ieps
                                        << " k=" << k
                                        << " alpha=" << alpha
                                        << " resNew=" << resNew
                                        << " resOld=" << resOld
                                        << " mass=" << trialMass
                                        << " maxRho=" << trialMaxRho
                                        << " maxU=" << trialMaxU
                                        << " relRhoDesign=" << trialRelRhoDesign
                                        << " branchOK=" << branchOK
                                        << endl;
                        }

                        if (branchOK && resNew <= (1.0 - armijoC*alpha)*resOld)
                        {
                                res = resNew;
                                accepted = true;

                                cout << "HYBRID_LOG "
                                        << ieps << " "
                                        << epsPhiRatio << " "
                                        << epsPhi << " "
                                        << k << " "
                                        << res << " "
                                        << nd << " "
                                        << alpha << " "
                                        << nBacktrack << " "
                                        << muShift << " "
                                        << u[].min << " "
                                        << u[].max << " "
                                        << trialMaxRho << " "
                                        << trialMass << " "
                                        << trialRelRhoDesign << " "
                                        << trialMaxU-c2Phi << " "
                                        << "ACCEPT"
                                        << endl;

                                break;
                        }

                        alpha *= betaLS;
                        nBacktrack++;
                }

                if (!accepted)
                {
                        u = uOld;
                        rhoFromPhi = ffun(u);
                        real relRhoDesignFail = sqrt(int2d(Th)((rhoFromPhi-rhoDesign)^2))/max(rhoDesignL2, 1e-30);

                        cout << "HYBRID_LOG "
                                << ieps << " "
                                << epsPhiRatio << " "
                                << epsPhi << " "
                                << k << " "
                                << resOld << " "
                                << nd << " "
                                << alpha << " "
                                << nBacktrack << " "
                                << muShift << " "
                                << u[].min << " "
                                << u[].max << " "
                                << rhoFromPhi[].max << " "
                                << int2d(Th)(rhoFromPhi) << " "
                                << relRhoDesignFail << " "
                                << u[].max-c2Phi << " "
                                << "FAIL_LS"
                                << endl;

                        muShift = min(muMax, 2.0*muShift);
                        cout << "SHIFT " << ieps << " " << k << " newMu=" << muShift << " reason=fail_ls" << endl;
                        rejectCount++;

                        if (rejectCount >= 5 || muShift >= muMax)
                        {
                                cout << "EPS_STOP " << ieps << " reason=too_many_failed_steps" << endl;
                                break;
                        }

                        continue;
                }

                rejectCount = 0;

                if (nBacktrack <= 1)
                {
                        muShift = max(muMin, 0.85*muShift);
                }
                else if (nBacktrack >= 8)
                {
                        muShift = min(muMax, 1.5*muShift);
                }

                real relDrop = abs(resOld-res)/max(resOld, 1e-30);

                if (relDrop < stagnationTol)
                {
                        stagnationCount++;
                        muShift = min(muMax, 1.25*muShift);
                        cout << "SHIFT " << ieps << " " << k << " newMu=" << muShift << " reason=stagnation" << endl;

                        if (stagnationCount >= maxStagnation)
                        {
                                cout << "EPS_STOP " << ieps << " reason=repeated_stagnation" << endl;
                                break;
                        }
                }
                else
                {
                        stagnationCount = 0;
                }

                if (plotDuringNewton == 1 && k % 5 == 0)
                {
                        plot(u, fill=true, value=true, wait=false, nbiso=50,
                                        cmm="Newton iterate u");

                        rhoFromPhi = ffun(u);
                        plot(rhoFromPhi, fill=true, value=true, wait=false, nbiso=50,
                                        cmm="Newton rho=f(u)\teps=" + epsPhiRatio + "\tresd=" + res);
                }
        }

        rhoFromPhi = ffun(u);
        real relRhoDesignEnd = sqrt(int2d(Th)((rhoFromPhi-rhoDesign)^2))/max(rhoDesignL2, 1e-30);

        cout << "EPS_END "
                << ieps << " "
                << epsPhiRatio << " "
                << epsPhi << " "
                << u[].min << " "
                << u[].max << " "
                << rhoFromPhi[].max << " "
                << int2d(Th)(rhoFromPhi) << " "
                << relRhoDesignEnd << " "
                << u[].max-c2Phi
                << endl;
}

// ----------------------------
// Final solution and diagnostics
// ----------------------------
rhoFromPhi = ffun(u);

defectFinal = -dy(u)*dx(rhoFromPhi) + dx(u)*dy(rhoFromPhi);
real defectFinalL2 = sqrt(int2d(Th)(defectFinal^2));
real gradRhoFinalL2 = sqrt(int2d(Th)(dx(rhoFromPhi)^2 + dy(rhoFromPhi)^2));
real gradPhiFinalL2 = sqrt(int2d(Th)(dx(u)^2 + dy(u)^2));
real normalizedDefectFinal = defectFinalL2/max(gradRhoFinalL2*gradPhiFinalL2, 1e-30);
real finalResidual = residualNorm();
real finalRelRhoDesign = sqrt(int2d(Th)((rhoFromPhi-rhoDesign)^2))/max(rhoDesignL2, 1e-30);

activeFinal = (rhoFromPhi > 0.05*rhoAmp);
plateauFinal = (rhoFromPhi > 0.90*rhoAmp);

cout << "FINAL "
<< "res=" << finalResidual << " "
<< "minPhi=" << u[].min << " "
<< "maxPhi=" << u[].max << " "
<< "c1Phi=" << c1Phi << " "
<< "c2Phi=" << c2Phi << " "
<< "epsPhi=" << epsPhi << " "
<< "maxRho=" << rhoFromPhi[].max << " "
<< "massRho=" << int2d(Th)(rhoFromPhi) << " "
<< "relRhoDesign=" << finalRelRhoDesign << " "
<< "annularCheckMaxPhiMinusC2=" << u[].max-c2Phi << " "
<< "normalizedDefect=" << normalizedDefectFinal
<< endl;

cout << "FINAL_BAND "
<< "activeArea=" << int2d(Th)(activeFinal) << " "
<< "plateauArea=" << int2d(Th)(plateauFinal) << " "
<< "plateauFraction=" << int2d(Th)(plateauFinal)/max(int2d(Th)(activeFinal), 1e-30)
<< endl;

if (plt == 1)
{
        plot(T, fill=true, value=true, wait=true, nbiso=60,
                        cmm="Torsion T");

        plot(rhoDesign, fill=true, value=true, wait=true, nbiso=60,
                        cmm="Designed rhoDesign = g_T(T)");

        plot(phiDesign, fill=true, value=true, wait=true, nbiso=60,
                        cmm="Poisson initializer phiDesign");

        plot(u, fill=true, value=true, wait=true, nbiso=60,
                        cmm="Final semilinear phi");

        plot(rhoFromPhi, fill=true, value=true, wait=true, nbiso=60,
                        cmm="Final semilinear rho=f(phi)");

        plot(defectFinal, fill=true, value=true, wait=true, nbiso=60,
                        cmm="Final stationarity defect");
}

// ----------------------------
// Save fields for simulation.
// ----------------------------
savemesh(Th, outMesh);

{
        ofstream frho(outRhoDof);
        frho << rhoFromPhi[];
}

{
        ofstream fphi(outPhiDof);
        fphi << u[];
}

savevtk(outVTK, Th, T, rhoDesign, phiDesign, u, rhoFromPhi, defectDesign, defectFinal, gradTNorm,
                dataname="T rhoDesign phiDesign phiFinal rhoFinal defectDesign defectFinal gradTNorm");

cout << "EXPORT "
<< outMesh << " "
<< outRhoDof << " "
<< outPhiDof << " "
<< outVTK
<< endl;

cout << "TIME_TOTAL " << clock()-tGlobal << endl;
cout << "========== END STRATEGY A FITTED-WINDOW NEWTON ==========" << endl;
