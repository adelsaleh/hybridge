
// ================================================================
// Strategy A no-adapt comparison runner: torsion-designed initializer
// + semilinear Newton on a fixed mesh.
//
// This version adds:
//    - command-line input for essentially all parameters except the hard-coded
//      epsPhi continuation list;
//    - compact terminal logging at every Newton/adaptation step;
//    - machine-readable CSV logs in ../logs;
//    - human-readable log in ../logs;
//    - metrics and outputs in ../out, ../vtk, ../msh, ../logs;
//    - exact unshifted Euclidean weak residual resEuclid for -Delta u = f(u)
//      without muShift/lambda;
//    - no mesh adaptation by default, for fixed-mesh comparison against HDG.
//    - fastest metrics only: resEuclid plus cheap state summaries.
//
// Recommended run:
//    FreeFem++ -v 0 strategyA_scheduled_adapt_euclid_fastres.edp
//
// Examples:
//    # ITER/Gmsh mesh
//    FreeFem++ -v 0 strategyA_scheduled_adapt_euclid_fastres.edp -mesh ../msh/iter.msh -meshReader 1 -runTag iter_eq_001
//
//    # Native star-shaped domain
//    FreeFem++ -v 0 strategyA_scheduled_adapt_euclid_fastres.edp -star 1 -starN 260 -runTag star_eq_001
//
// Downstream import folder:
//    ../runs/<runTag>/equilibrium
// ================================================================

include "getARGV.idp"
load "gmsh"
load "iovtk"

// Suppress FreeFEM solver chatter as much as possible.
// You should also run FreeFem++ with -v 0.
verbosity = getARGV("-verbosity", 0);

// ----------------------------
// User-input parameters
// ----------------------------
int bLabel = getARGV("-bLabel", 1);

int plt = getARGV("-plot", 0);
int plotInitial = getARGV("-plotInitial", 0);
int plotDesign = getARGV("-plotDesign", 0);
int plotDuringNewton = getARGV("-plotNewton", 0);
int plotNewtonEvery = getARGV("-plotNewtonEvery", 5);
int plotAdaptOverlay = getARGV("-plotAdapt", 0);
int plotFinal = getARGV("-plotFinal", 0);
int verboseLS = getARGV("-verboseLS", 0);

int terminalEvery = getARGV("-terminalEvery", 1);
int terminalDetailed = getARGV("-terminalDetailed", 0);

// Frame output for visualizing band evolution.
// Frames are VTU snapshots, not raster images. By default frameEvery
// equals plotNewtonEvery, so one frame is saved each time the Newton
// plot updates. Use the Python postprocessor to render PNG frames or
// assemble an animation.
int saveFrames = getARGV("-saveFrames", 0);
int frameEvery = getARGV("-frameEvery", plotNewtonEvery);
int frameDesign = getARGV("-frameDesign", 0);
int frameAdapt = getARGV("-frameAdapt", 0);
int frameFinal = getARGV("-frameFinal", 0);
int saveFinalOutputs = getARGV("-saveFinalOutputs", 0);

// ----------------------------
// Geometry / mesh selection
// ----------------------------
// Default mode reads an existing ITER-like Gmsh mesh. Use -star 1 to build
// a native star-shaped test domain instead.
int useStar = getARGV("-star", 0);
string meshFile = getARGV("-mesh", "../msh/iter.msh");

// For file meshes: 1 = gmshload, 0 = readmesh.
// Use gmshload for iter.msh. Use readmesh for meshes saved by FreeFEM.
int meshReader = getARGV("-meshReader", 1);

// Native star-shaped geometry parameters, used only when -star 1.
int starN = getARGV("-starN", 260);
real starR0 = getARGV("-starR0", 1.5);
real starAmp = getARGV("-starAmp", 0.32);
int starMode = getARGV("-starMode", 5);

// ----------------------------
// Run-specific output layout
// ----------------------------
// By default this solver never writes rho_dof.txt, phi_dof.txt, or
// equilibrium_mesh.msh into the current directory or shared ../out/../msh.
// Instead it creates a run-specific folder:
//
//  ../runs/<runTag>/equilibrium/{equilibrium_mesh.msh,rho_dof.txt,phi_dof.txt}
//   ../runs/<runTag>/{out,vtk,msh,logs}
//
// This lets a downstream solver such as CG_SUPG_o1_star_native_taufix_v9.edp
// import from a specific equilibrium folder without erasing older runs.
string runTag = getARGV("-runTag", "strategyA_scheduled_adapt_euclid_fastres");
string runRoot = getARGV("-runRoot", "../runs");
string runDir = getARGV("-runDir", runRoot + "/" + runTag);
string importDir = getARGV("-importDir", runDir + "/equilibrium");

string outDir = getARGV("-outDir", runDir + "/out");
string vtkDir = getARGV("-vtkDir", runDir + "/vtk");
string mshDir = getARGV("-mshDir", runDir + "/msh");
string logDir = getARGV("-logDir", runDir + "/logs");
string frameDir = getARGV("-frameDir", runDir + "/frames");

// Torsion-designed band parameters.
// epsTRatio is intentionally hard-coded by request.
real alphaT1 = getARGV("-alphaT1", 0.6);
real alphaT2 = getARGV("-alphaT2", 0.7);
real epsTRatio = 0.06;
real rhoAmp = getARGV("-rhoAmp", 1.0);

// Semilinear f(phi) window parameters from phiDesign scale.
real betaPhi1 = getARGV("-betaPhi1", 0.6);
real betaPhi2 = getARGV("-betaPhi2", 0.7);

// Continuation in epsilon for the semilinear f(phi).
// Kept hard-coded by request.
int nEpsPhi = 3;
real[int] epsPhiRatioList(nEpsPhi);
epsPhiRatioList[0] = 0.11;
epsPhiRatioList[1] = 0.08;
epsPhiRatioList[2] = 0.06;

// Newton parameters.
int maxIt = getARGV("-maxIt", 70);
real tolRes = getARGV("-tolRes", 1e-10);
real tolNewton = getARGV("-tolNewton", 1e-10);
real betaLS = getARGV("-betaLS", 0.5);
real armijoC = getARGV("-armijoC", 1e-6);
real alphaMin = getARGV("-alphaMin", 1e-7);
int maxBacktrack = getARGV("-maxBacktrack", 30);

// Shifted Newton stabilization.
int useMuShift = getARGV("-useMuShift", 0);
real muShift = getARGV("-muShift", 2.0);
real muMin = getARGV("-muMin", 0.20);
real muMax = getARGV("-muMax", 30.0);
real muAcceptFactor = getARGV("-muAcceptFactor", 0.85);
real muHardBacktrackFactor = getARGV("-muHardBacktrackFactor", 1.5);
real muFailFactor = getARGV("-muFailFactor", 2.0);
real muStagnationFactor = getARGV("-muStagnationFactor", 1.25);
if (useMuShift == 0)
{
    muShift = 0.0;
}

// Branch preservation: only prevent collapse. Do not force annularity.
real massFloorFraction = getARGV("-massFloorFraction", 0.01);
real rhoMaxFloor = getARGV("-rhoMaxFloor", 0.02);

// Repeated stagnation stop.
int maxStagnation = getARGV("-maxStagnation", 5);
real stagnationTol = getARGV("-stagnationTol", 1e-5);

// Band metrics thresholds.
real activeThreshold = getARGV("-activeThreshold", 0.05);
real plateauThreshold = getARGV("-plateauThreshold", 0.90);

// ----------------------------
// Mesh adaptation parameters
// ----------------------------
// Simplified policy:
//   1. pre-adapt once from the designed torsion band;
//   2. during each epsilon stage, adapt once after a fixed number of
//      accepted Newton steps, when the band has started to stabilize.
// The lower mesh scale is fixed to the original mesh minimum edge length.
// The upper mesh scale is fixed to the original mesh maximum edge length,
// which biases the adapted mesh toward a triangle count comparable to the
// input mesh.
int preAdaptDesign = 0;
int useAdaptMesh = 0;
int adaptAfterLastEps = getARGV("-adaptAfterLastEps", 0);
int adaptAfterAccepted = getARGV("-adaptAfterAccepted", 5);

// Main user-facing adaptivity control. Larger values make the indicator more
// reactive to the density-band gradient. Default is deliberately high.
real adaptGradWeight = getARGV("-adaptGradWeight", 10.0);

// Internal adaptmesh parameters. Kept fixed for this simplified solver.
real adaptErr = 0.02;
real adaptErrG = 0.01;
real adaptRatio = 1.8;
real adaptAnisoMax = 10.0;
int adaptNbVx = getARGV("-adaptNbVx", 500000);
int adaptNbSmooth = 3;
int adaptVerbosity = getARGV("-adaptVerbosity", 0);

// Set from the original mesh immediately after loading.
real initialHMin = 0.0;
real initialHMax = 0.0;
real adaptHMin = 0.0;
real adaptHMax = 0.0;

// Outputs.
// Compatibility import files for the downstream CG/SUPG solver. These are
// intentionally placed in importDir and use the exact legacy names.
string outMesh = importDir + "/equilibrium_mesh.msh";
string outRhoDof = importDir + "/rho_dof.txt";
string outPhiDof = importDir + "/phi_dof.txt";

// Additional named artifacts for inspection/postprocessing.
string namedMesh = mshDir + "/" + runTag + "_equilibrium_mesh.msh";
string namedRhoDof = outDir + "/" + runTag + "_rho_dof.txt";
string namedPhiDof = outDir + "/" + runTag + "_phi_dof.txt";
string outVTK = vtkDir + "/" + runTag + "_final.vtu";
string csvLogFile = logDir + "/" + runTag + "_newton.csv";
string adaptLogFile = logDir + "/" + runTag + "_adapt.csv";
string humanLogFile = logDir + "/" + runTag + ".log";
string frameLogFile = logDir + "/" + runTag + "_frames.csv";
string summaryFile = outDir + "/" + runTag + "_summary.txt";

// Try to create output directories.
exec("mkdir -p " + runDir);
exec("mkdir -p " + importDir);
exec("mkdir -p " + outDir);
exec("mkdir -p " + vtkDir);
exec("mkdir -p " + mshDir);
exec("mkdir -p " + logDir);
exec("mkdir -p " + frameDir);

// ----------------------------
// Timing and log streams
// ----------------------------
real tGlobal = clock();
real tBlock;
real tSolve;
real tResidual;
real tAdapt;
real tStep;

ofstream csvlog(csvLogFile);
ofstream adaptlog(adaptLogFile);
ofstream humanlog(humanLogFile);
ofstream framelog(frameLogFile);
ofstream summary(summaryFile);

// On most FreeFEM builds these stream methods work.
// If your build complains, comment out the next four lines.
csvlog.precision(16);
adaptlog.precision(16);
humanlog.precision(16);
framelog.precision(16);
summary.precision(16);

csvlog
    << "record,runTag,ieps,epsPhiRatio,epsPhi,k,nt,ndof,"
    << "resEuclid,resHm1Disabled,resHm1RelEnergyDisabled,resHm1RelRhoDisabled,poissonRelL2Disabled,poissonRelH1Disabled,"
    << "strongResL2,strongResRelEnergy,strongResRelRho,strongResMaxAbs,"
    << "nd,alpha,bt,muShift,minU,maxU,maxRho,massRho,rhoL2,energyPhi,J,"
    << "activeArea,plateauArea,plateauFrac,relRhoDesign,annularPhiMinusC2,"
    << "defectL2,normalizedDefect,gradRhoL2,solveTime,metricTime,stepTime,status"
    << endl;

adaptlog
    << "record,runTag,ieps,k,ntOld,ndofOld,ntNew,ndofNew,epsPhi,"
    << "hMinUsed,hMax,err,errg,ratio,anisomax,adaptGradWeight,"
    << "rhoMassBefore,rhoMaxBefore,rhoMassAfter,rhoMaxAfter,"
    << "massRelChange,maxRhoRelChange,activeAreaBefore,activeAreaAfter,activeAreaRelChange,"
    << "adaptTime,status"
    << endl;

framelog
    << "frame,runTag,stage,ieps,k,nt,ndof,epsPhi,resEuclid,massRho,maxRho,activeArea,plateauArea,relRhoDesign,filename"
    << endl;

int frameCounter = 0;

cout << endl;
cout << "========== START STRATEGY A NOADAPT TORSION NEWTON ==========" << endl;
cout << "RUN_TAG " << runTag << endl;
cout << "RUN_DIR " << runDir << endl;
cout << "IMPORT_DIR " << importDir << endl;
cout << "CSV_LOG " << csvLogFile << endl;
cout << "ADAPT_LOG " << adaptLogFile << endl;
cout << "HUMAN_LOG " << humanLogFile << endl;
cout << "SUMMARY " << summaryFile << endl;
cout << "FRAME_LOG " << frameLogFile << endl;
cout << "FRAME_DIR " << frameDir << endl;

humanlog << "START runTag=" << runTag << endl;
humanlog << "runDir=" << runDir << endl;
humanlog << "importDir=" << importDir << endl;
humanlog << "useStar=" << useStar << " meshFile=" << meshFile << " meshReader=" << meshReader << endl;
humanlog << "starN=" << starN << " starR0=" << starR0 << " starAmp=" << starAmp << " starMode=" << starMode << endl;
humanlog << "outDir=" << outDir << " vtkDir=" << vtkDir << " mshDir=" << mshDir << " logDir=" << logDir << endl;
humanlog << "frameDir=" << frameDir << " frameLog=" << frameLogFile << " saveFrames=" << saveFrames << " frameEvery=" << frameEvery << " plotNewtonEvery=" << plotNewtonEvery << endl;
humanlog << "alphaT1=" << alphaT1 << " alphaT2=" << alphaT2 << " epsTRatio=" << epsTRatio << " rhoAmp=" << rhoAmp << endl;
humanlog << "betaPhi1=" << betaPhi1 << " betaPhi2=" << betaPhi2 << endl;
humanlog << "epsPhiRatios=" << epsPhiRatioList[0] << "," << epsPhiRatioList[1] << "," << epsPhiRatioList[2] << endl;
humanlog << "useMuShift=" << useMuShift << " muShiftInitial=" << muShift
         << " muMin=" << muMin << " muMax=" << muMax
         << " muAcceptFactor=" << muAcceptFactor
         << " muHardBacktrackFactor=" << muHardBacktrackFactor
         << " muFailFactor=" << muFailFactor
         << " muStagnationFactor=" << muStagnationFactor << endl;
humanlog << "adapt=" << useAdaptMesh << " preAdaptDesign=" << preAdaptDesign << " adaptAfterAccepted=" << adaptAfterAccepted << " adaptGradWeight=" << adaptGradWeight << endl;

// ----------------------------
// Mesh and FE spaces
// ----------------------------
// Native star-shaped domain, used when -star 1.
border GammaStar(t=0, 2*pi)
{
    real rrStar = starR0 + starAmp*cos(starMode*t);
    x = rrStar*cos(t);
    y = rrStar*sin(t);
    label = bLabel;
}

tBlock = clock();
mesh Th;
if (useStar == 1)
{
    Th = buildmesh(GammaStar(starN));
    cout << "GEOMETRY star starN=" << starN << " r0=" << starR0 << " amp=" << starAmp << " mode=" << starMode << endl;
    humanlog << "GEOMETRY star starN=" << starN << " r0=" << starR0 << " amp=" << starAmp << " mode=" << starMode << endl;
}
else
{
    if (meshReader == 1)
    {
        Th = gmshload(meshFile);
    }
    else
    {
        Th = readmesh(meshFile);
    }
    cout << "GEOMETRY file meshFile=" << meshFile << " meshReader=" << meshReader << endl;
    humanlog << "GEOMETRY file meshFile=" << meshFile << " meshReader=" << meshReader << endl;
}
cout << "MESH nt=" << Th.nt << " loadTime=" << clock()-tBlock << endl;
humanlog << "MESH nt=" << Th.nt << " loadTime=" << clock()-tBlock << endl;

// Compute original mesh scales once. These values are reused for all
// adaptations, so hmin cannot shrink during the run.
initialHMin = 1e100;
initialHMax = 0.0;
for (int ih = 0; ih < Th.nt; ih++)
{
    real x0h = Th[ih][0].x;
    real y0h = Th[ih][0].y;
    real x1h = Th[ih][1].x;
    real y1h = Th[ih][1].y;
    real x2h = Th[ih][2].x;
    real y2h = Th[ih][2].y;

    real h01 = sqrt((x1h-x0h)^2 + (y1h-y0h)^2);
    real h12 = sqrt((x2h-x1h)^2 + (y2h-y1h)^2);
    real h20 = sqrt((x0h-x2h)^2 + (y0h-y2h)^2);

    initialHMin = min(initialHMin, h01);
    initialHMin = min(initialHMin, h12);
    initialHMin = min(initialHMin, h20);
    initialHMax = max(initialHMax, h01);
    initialHMax = max(initialHMax, h12);
    initialHMax = max(initialHMax, h20);
}
adaptHMin = initialHMin;
adaptHMax = initialHMax;

cout << "INITIAL_MESH_SCALE hMin=" << initialHMin << " hMax=" << initialHMax << endl;
humanlog << "INITIAL_MESH_SCALE hMin=" << initialHMin << " hMax=" << initialHMax << endl;

if (plt == 1 && plotInitial == 1)
{
    plot(Th, wait=true, cmm="Initial mesh");
}

tBlock = clock();
fespace Vh(Th, P2);
Vh T, phiDesign, rhoDesign, rhoFromPhi;
Vh u, du, v, uTrial, uOld, tmp, phiCheck, zHminus;
Vh defectDesign, defectFinal, gradTNorm, gradPhiMag, strongResidualField, adaptIndicator;
Vh activeDesign, plateauDesign, activeFinal, plateauFinal;

real[int] rr(Vh.ndof);
real[int] zz(Vh.ndof);

cout << "SPACE ndof=" << Vh.ndof << " allocTime=" << clock()-tBlock << endl;
humanlog << "SPACE ndof=" << Vh.ndof << " allocTime=" << clock()-tBlock << endl;

// ----------------------------
// Torsion solve
// ----------------------------
problem Torsion(T, v, solver=sparsesolver)
    =
    int2d(Th)(
        dx(T)*dx(v)
        + dy(T)*dy(v)
    )
    - int2d(Th)(
        1.0*v
    )
    + on(bLabel, T=0);

tSolve = clock();
Torsion;
real torsionTime = clock()-tSolve;

if (plt == 1 && plotDesign == 1)
{
    plot(T, fill=true, value=true, wait=true, cmm="Torsion phi");
}

real Tmax = T[].max;
real Tmin = T[].min;

if (Tmax <= 1e-14)
{
    cout << "ERROR Tmax_too_small check_bLabel=" << bLabel << endl;
    humanlog << "ERROR Tmax_too_small check_bLabel=" << bLabel << endl;
    exec("exit 1");
}

real c1T = alphaT1*Tmax;
real c2T = alphaT2*Tmax;
real widthT = c2T-c1T;
real epsT = epsTRatio*widthT;

cout << "TORSION Tmax=" << Tmax << " c1T=" << c1T << " c2T=" << c2T << " epsT=" << epsT << endl;

humanlog
    << "TORSION "
    << "Tmin=" << Tmin << " "
    << "Tmax=" << Tmax << " "
    << "alphaT1=" << alphaT1 << " "
    << "alphaT2=" << alphaT2 << " "
    << "c1T=" << c1T << " "
    << "c2T=" << c2T << " "
    << "widthT=" << widthT << " "
    << "epsTRatio=" << epsTRatio << " "
    << "epsT=" << epsT << " "
    << "time=" << torsionTime
    << endl;

// ----------------------------
// Torsion-window functions g_T
// ----------------------------
func real sigmaT(real z)
{
    real zz = z/epsT;

    if (zz > 50.0)
        return 1.0;

    if (zz < -50.0)
        return 0.0;

    return 1.0/(1.0 + exp(-zz));
}

func real gT(real s)
{
    return rhoAmp*(sigmaT(s-c1T) - sigmaT(s-c2T));
}

rhoDesign = gT(T);

if (plt == 1 && plotDesign == 1)
{
    plot(Th, rhoDesign, fill=true, value=true, wait=true, nbiso=50,
        cmm="Design rho with mesh overlay");
}

gradTNorm = sqrt(dx(T)^2 + dy(T)^2);
activeDesign = (rhoDesign > activeThreshold*rhoAmp);
plateauDesign = (rhoDesign > plateauThreshold*rhoAmp);

real rhoDesignMass = int2d(Th)(rhoDesign);
real rhoDesignL2 = sqrt(int2d(Th)(rhoDesign^2));

cout
    << "RHO_DESIGN "
    << "mass=" << rhoDesignMass << " "
    << "max=" << rhoDesign[].max << " "
    << "activeArea=" << int2d(Th)(activeDesign) << " "
    << "plateauArea=" << int2d(Th)(plateauDesign)
    << endl;

humanlog
    << "RHO_DESIGN "
    << "rhoMin=" << rhoDesign[].min << " "
    << "rhoMax=" << rhoDesign[].max << " "
    << "rhoMass=" << rhoDesignMass << " "
    << "rhoL2=" << rhoDesignL2 << " "
    << "activeArea=" << int2d(Th)(activeDesign) << " "
    << "plateauArea=" << int2d(Th)(plateauDesign) << " "
    << "plateauFraction=" << int2d(Th)(plateauDesign)/max(int2d(Th)(activeDesign), 1e-30)
    << endl;

// ----------------------------
// Poisson solve for phiDesign
// ----------------------------
varf a(uu,vv)
    =
    int2d(Th)(
        dx(uu)*dx(vv)
        + dy(uu)*dy(vv)
    )
    + on(bLabel, uu=0);

varf m(uu,vv)
    =
    int2d(Th)(
        uu*vv
    );

matrix K = a(Vh,Vh);
matrix M = m(Vh,Vh);

tmp[] = M*rhoDesign[];
phiDesign[] = K^-1*tmp[];

// Mesh-safe Poisson solve for recomputing phiDesign after pre-adaptation.
problem PoissonDesignSolve(phiDesign, v, solver=sparsesolver)
    =
    int2d(Th)(
        dx(phiDesign)*dx(v)
        + dy(phiDesign)*dy(v)
    )
    - int2d(Th)(
        rhoDesign*v
    )
    + on(bLabel, phiDesign=0);

real phiDesignMax = phiDesign[].max;
real phiDesignMin = phiDesign[].min;
real phiDesignL2 = sqrt(int2d(Th)(phiDesign^2));
real phiDesignEnergy = sqrt(int2d(Th)(dx(phiDesign)^2 + dy(phiDesign)^2));

defectDesign = -dy(phiDesign)*dx(rhoDesign) + dx(phiDesign)*dy(rhoDesign);
real defectDesignL2 = sqrt(int2d(Th)(defectDesign^2));
real gradRhoDesignL2 = sqrt(int2d(Th)(dx(rhoDesign)^2 + dy(rhoDesign)^2));
real normalizedDefectDesign = defectDesignL2/max(gradRhoDesignL2*phiDesignEnergy, 1e-30);

cout
    << "PHI_DESIGN "
    << "max=" << phiDesignMax << " "
    << "energy=" << phiDesignEnergy << " "
    << "normalizedDefect=" << normalizedDefectDesign
    << endl;

humanlog
    << "PHI_DESIGN "
    << "phiMin=" << phiDesignMin << " "
    << "phiMax=" << phiDesignMax << " "
    << "phiL2=" << phiDesignL2 << " "
    << "energy=" << phiDesignEnergy << " "
    << "defectL2=" << defectDesignL2 << " "
    << "normalizedDefect=" << normalizedDefectDesign
    << endl;

if (phiDesignMax <= 1e-14)
{
    cout << "ERROR phiDesignMax_too_small cannot_define_phi_window" << endl;
    humanlog << "ERROR phiDesignMax_too_small cannot_define_phi_window" << endl;
    exec("exit 1");
}


// ----------------------------
// Optional pre-adaptation from the designed band before Newton.
//
// This adapts the mesh to rhoDesign and phiDesign before defining the
// semilinear Newton problem. It is cheaper and safer than waiting until after
// one Newton continuation level, because all subsequent FE problems are built
// on the already band-resolved mesh.
// ----------------------------
if (preAdaptDesign == 1)
{
    tAdapt = clock();
    gradPhiMag = sqrt(dx(phiDesign)^2 + dy(phiDesign)^2);

    real maxGradPre = max(gradPhiMag[].max, gradTNorm[].max);
    real hTargetPre = adaptHMin;
    real hMinPre = adaptHMin;
    real ntPreOld = Th.nt;
    real ndofPreOld = Vh.ndof;
    real rhoMassPreOld = int2d(Th)(rhoDesign);
    real rhoMaxPreOld = rhoDesign[].max;

    cout
        << "PREADAPT_START "
        << "nt=" << ntPreOld
        << " ndof=" << ndofPreOld
        << " hMinUsed=" << hMinPre
        << " hMax=" << adaptHMax
        << " err=" << adaptErr
        << endl;

    humanlog
        << "PREADAPT_START "
        << "nt=" << ntPreOld << " "
        << "ndof=" << ndofPreOld << " "
        << "epsT=" << epsT << " "
        << "maxGradPre=" << maxGradPre << " "
        << "hTargetPre=" << hTargetPre << " "
        << "hMinUsed=" << hMinPre << " "
        << "hMax=" << adaptHMax << " "
        << "err=" << adaptErr
        << endl;

    if (plt == 1 && plotAdaptOverlay == 1)
    {
        plot(Th, rhoDesign, fill=true, value=true, wait=false, nbiso=60,
            cmm="Before pre-adapt: rhoDesign with mesh overlay");
    }

    adaptIndicator = rhoDesign + adaptGradWeight*epsT*sqrt(dx(rhoDesign)^2 + dy(rhoDesign)^2);

    Th = adaptmesh(
        Th,
        adaptIndicator,
        err=adaptErr,
        errg=adaptErrG,
        hmin=hMinPre,
        hmax=adaptHMax,
        nbvx=adaptNbVx,
        ratio=adaptRatio,
        anisomax=adaptAnisoMax,
        nbsmooth=adaptNbSmooth,
        verbosity=adaptVerbosity
    );

    // Re-interpolate all design fields on the pre-adapted mesh, then recompute
    // the Poisson initializer on the adapted mesh.
    T = T;
    phiDesign = phiDesign;
    rhoDesign = gT(T);
    PoissonDesignSolve;
    gradTNorm = sqrt(dx(T)^2 + dy(T)^2);
    activeDesign = (rhoDesign > activeThreshold*rhoAmp);
    plateauDesign = (rhoDesign > plateauThreshold*rhoAmp);

    rhoDesignMass = int2d(Th)(rhoDesign);
    rhoDesignL2 = sqrt(int2d(Th)(rhoDesign^2));
    phiDesignMax = phiDesign[].max;
    phiDesignMin = phiDesign[].min;
    phiDesignL2 = sqrt(int2d(Th)(phiDesign^2));
    phiDesignEnergy = sqrt(int2d(Th)(dx(phiDesign)^2 + dy(phiDesign)^2));

    real ntPreNew = Th.nt;
    real ndofPreNew = Vh.ndof;
    real rhoMassPreNew = int2d(Th)(rhoDesign);
    real rhoMaxPreNew = rhoDesign[].max;
    real massRelPre = abs(rhoMassPreNew-rhoMassPreOld)/max(abs(rhoMassPreOld), 1e-30);
    real maxRhoRelPre = abs(rhoMaxPreNew-rhoMaxPreOld)/max(abs(rhoMaxPreOld), 1e-30);
    real preAdaptTime = clock()-tAdapt;

    cout
        << "PREADAPT_DONE "
        << "ntNew=" << ntPreNew
        << " ndofNew=" << ndofPreNew
        << " massRelChange=" << massRelPre
        << " time=" << preAdaptTime
        << endl;

    humanlog
        << "PREADAPT_DONE "
        << "ntOld=" << ntPreOld << " "
        << "ndofOld=" << ndofPreOld << " "
        << "ntNew=" << ntPreNew << " "
        << "ndofNew=" << ndofPreNew << " "
