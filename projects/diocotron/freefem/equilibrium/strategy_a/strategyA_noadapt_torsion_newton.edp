                                    csvlog
                        << "NEWTON" << ","
                        << runTag << ","
                        << ieps << ","
                        << epsPhiRatio << ","
                        << epsPhi << ","
                        << k << ","
                        << Th.nt << ","
                        << Vh.ndof << ","
                        << resEuclid << ","
                        << resHm1 << ","
                        << resHm1RelEnergy << ","
                        << resHm1RelRho << ","
                        << poissonRelL2 << ","
                        << poissonRelH1 << ","
                        << strongResL2 << ","
                        << strongResRelEnergy << ","
                        << strongResRelRho << ","
                        << strongResMaxAbs << ","
                        << nd << ","
                        << alpha << ","
                        << nBacktrack << ","
                        << muShift << ","
                        << u[].min << ","
                        << u[].max << ","
                        << rhoFromPhi[].max << ","
                        << int2d(Th)(rhoFromPhi) << ","
                        << rhoL2Now << ","
                        << energyPhiNow << ","
                        << JNow << ","
                        << activeAreaNow << ","
                        << plateauAreaNow << ","
                        << plateauFracNow << ","
                        << relRhoDesignNow << ","
                        << u[].max-c2Phi << ","
                        << defectL2Now << ","
                        << normalizedDefectNow << ","
                        << gradRhoL2Now << ","
                        << newtonSolveTime << ","
                        << metricsTimeNow << ","
                        << clock()-tStep << ","
                        << "ACCEPT"
                        << endl;

                if (saveFrames == 1 && frameEvery > 0 && (k % frameEvery == 0))
                {
                    string frameFileAccept = frameDir + "/" + runTag + "_frame_" + frameCounter + "_ieps_" + ieps + "_k_" + k + "_accept.vtu";
                    savevtk(frameFileAccept, Th, u, rhoFromPhi, rhoDesign, phiDesign,
                        dataname="phi rho rhoDesign phiDesign");
                    framelog
                        << frameCounter << ","
                        << runTag << ","
                        << "ACCEPT" << ","
                        << ieps << ","
                        << k << ","
                        << Th.nt << ","
                        << Vh.ndof << ","
                        << epsPhi << ","
                        << resEuclid << ","
                        << int2d(Th)(rhoFromPhi) << ","
                        << rhoFromPhi[].max << ","
                        << activeAreaNow << ","
                        << plateauAreaNow << ","
                        << relRhoDesignNow << ","
                        << frameFileAccept
                        << endl;
                    frameCounter++;
                }

                                    cout
                        << "STEP "
                        << "ieps=" << ieps
                        << " k=" << k
                        << " resE=" << resEuclid
                        << " alpha=" << alpha
                        << " bt=" << nBacktrack
                        << " mu=" << muShift
                        << " maxU=" << u[].max
                        << " maxRho=" << rhoFromPhi[].max
                        << " mass=" << int2d(Th)(rhoFromPhi)
                        << " relDesign=" << relRhoDesignNow
                        << " solveT=" << newtonSolveTime
                        << " metricT=" << metricsTimeNow
                        << " stepT=" << clock()-tStep
                        << " status=ACCEPT"
                        << endl;

                break;
            }

            alpha *= betaLS;
            nBacktrack++;
        }

        if (!accepted)
        {
            u = uOld;
            /* inline ComputeFastMetrics */
tMetrics = clock();
rhoFromPhi = ffun(u);
activeFinal = (rhoFromPhi > activeThreshold*rhoAmp);
plateauFinal = (rhoFromPhi > plateauThreshold*rhoAmp);

rr.resize(Vh.ndof);
rr = 0.0;
rr = ResidualForm(0, Vh);
resEuclid = sqrt(rr'*rr);

// H^{-1}_h residual disabled for speed.
// resEuclid is now the only Newton/Armijo residual metric.
resHm1 = 0.0;

rhoL2Now = sqrt(int2d(Th)(rhoFromPhi^2));
energyPhiNow = sqrt(int2d(Th)(dx(u)^2 + dy(u)^2));

resHm1RelEnergy = 0.0;
resHm1RelRho = 0.0;

// Disabled expensive diagnostics for speed.
poissonRelL2 = 0.0;
poissonRelH1 = 0.0;
strongResL2 = 0.0;
strongResRelEnergy = 0.0;
strongResRelRho = 0.0;
strongResMaxAbs = 0.0;
defectL2Now = 0.0;
gradRhoL2Now = 0.0;
normalizedDefectNow = 0.0;

JNow = 0.5*int2d(Th)(dx(u)^2 + dy(u)^2) - int2d(Th)(Ffun(u));

activeAreaNow = int2d(Th)(activeFinal);
plateauAreaNow = int2d(Th)(plateauFinal);
plateauFracNow = plateauAreaNow/max(activeAreaNow, 1e-30);

relRhoDesignNow = sqrt(int2d(Th)((rhoFromPhi-rhoDesign)^2))/max(rhoDesignL2, 1e-30);

metricsTimeNow = clock()-tMetrics;

            res = resOld;

                        csvlog
                << "NEWTON" << ","
                << runTag << ","
                << ieps << ","
                << epsPhiRatio << ","
                << epsPhi << ","
                << k << ","
                << Th.nt << ","
                << Vh.ndof << ","
                << resEuclid << ","
                << resHm1 << ","
                << resHm1RelEnergy << ","
                << resHm1RelRho << ","
                << poissonRelL2 << ","
                << poissonRelH1 << ","
                << strongResL2 << ","
                << strongResRelEnergy << ","
                << strongResRelRho << ","
                << strongResMaxAbs << ","
                << nd << ","
                << alpha << ","
                << nBacktrack << ","
                << muShift << ","
                << u[].min << ","
                << u[].max << ","
                << rhoFromPhi[].max << ","
                << int2d(Th)(rhoFromPhi) << ","
                << rhoL2Now << ","
                << energyPhiNow << ","
                << JNow << ","
                << activeAreaNow << ","
                << plateauAreaNow << ","
                << plateauFracNow << ","
                << relRhoDesignNow << ","
                << u[].max-c2Phi << ","
                << defectL2Now << ","
                << normalizedDefectNow << ","
                << gradRhoL2Now << ","
                << newtonSolveTime << ","
                << metricsTimeNow << ","
                << clock()-tStep << ","
                << "FAIL_LS"
                << endl;
                        cout
                << "STEP "
                << "ieps=" << ieps
                << " k=" << k
                << " resE=" << resEuclid
                << " alpha=" << alpha
                << " bt=" << nBacktrack
                << " mu=" << muShift
                << " maxU=" << u[].max
                << " maxRho=" << rhoFromPhi[].max
                << " mass=" << int2d(Th)(rhoFromPhi)
                << " relDesign=" << relRhoDesignNow
                << " solveT=" << newtonSolveTime
                << " metricT=" << metricsTimeNow
                << " stepT=" << clock()-tStep
                << " status=FAIL_LS"
                << endl;

                if (useMuShift == 1)
                {
                    muShift = min(muMax, muFailFactor*muShift);
                }

            humanlog
                << "SHIFT "
                << "ieps=" << ieps << " "
                << "k=" << k << " "
                << "newMu=" << muShift << " "
                << "reason=fail_ls"
                << endl;

            rejectCount++;

            if (rejectCount >= 5 || muShift >= muMax)
            {
                cout << "EPS_STOP ieps=" << ieps << " reason=too_many_failed_steps" << endl;
                humanlog << "EPS_STOP ieps=" << ieps << " reason=too_many_failed_steps" << endl;
                break;
            }

            continue;
        }

        rejectCount = 0;
        acceptedStepsThisEps++;

        if (
            useAdaptMesh == 1
            && adaptedThisEps == 0
            && acceptedStepsThisEps >= adaptAfterAccepted
            && (ieps < nEpsPhi-1 || adaptAfterLastEps == 1)
        )
        {
            tAdapt = clock();
            rhoFromPhi = ffun(u);
            activeFinal = (rhoFromPhi > activeThreshold*rhoAmp);
            plateauFinal = (rhoFromPhi > plateauThreshold*rhoAmp);

            real ntOldSched = Th.nt;
            real ndofOldSched = Vh.ndof;
            real massBeforeSched = int2d(Th)(rhoFromPhi);
            real maxRhoBeforeSched = rhoFromPhi[].max;
            real activeBeforeSched = int2d(Th)(activeFinal);

            cout
                << "ADAPT_SCHEDULE_START "
                << "ieps=" << ieps
                << " k=" << k
                << " accepted=" << acceptedStepsThisEps
                << " nt=" << ntOldSched
                << " ndof=" << ndofOldSched
                << " hMin=" << adaptHMin
                << " hMax=" << adaptHMax
                << " gradWeight=" << adaptGradWeight
                << endl;

            if (plt == 1 && plotAdaptOverlay == 1)
            {
                plot(Th, rhoFromPhi, fill=true, value=true, wait=false, nbiso=60,
                    cmm="Before scheduled adapt: rho=f(u) with mesh overlay");
            }

            adaptIndicator = rhoFromPhi + adaptGradWeight*epsPhi*sqrt(dx(rhoFromPhi)^2 + dy(rhoFromPhi)^2);
            uOld = u;

            if (saveFrames == 1 && frameAdapt == 1)
            {
                string frameFileBeforeAdapt = frameDir + "/" + runTag + "_frame_" + frameCounter + "_ieps_" + ieps + "_k_" + k + "_before_adapt.vtu";
                savevtk(frameFileBeforeAdapt, Th, u, rhoFromPhi, rhoDesign, phiDesign, adaptIndicator,
                    dataname="phi rho rhoDesign phiDesign adaptIndicator");
                framelog
                    << frameCounter << "," << runTag << "," << "BEFORE_ADAPT" << ","
                    << ieps << "," << k << "," << Th.nt << "," << Vh.ndof << ","
                    << epsPhi << "," << resEuclid << "," << massBeforeSched << "," << maxRhoBeforeSched << ","
                    << activeBeforeSched << "," << int2d(Th)(plateauFinal) << "," << relRhoDesignNow << ","
                    << frameFileBeforeAdapt << endl;
                frameCounter++;
            }

            Th = adaptmesh(
                Th,
                adaptIndicator,
                err=adaptErr,
                errg=adaptErrG,
                hmin=adaptHMin,
                hmax=adaptHMax,
                nbvx=adaptNbVx,
                ratio=adaptRatio,
                anisomax=adaptAnisoMax,
                nbsmooth=adaptNbSmooth,
                verbosity=adaptVerbosity
            );

            T = T;
            phiDesign = phiDesign;
            rhoDesign = gT(T);
            u = uOld;
            du = 0.0;
            uTrial = u;
            uOld = u;
            rhoFromPhi = ffun(u);
            activeFinal = (rhoFromPhi > activeThreshold*rhoAmp);
            plateauFinal = (rhoFromPhi > plateauThreshold*rhoAmp);
            rhoDesignMass = int2d(Th)(rhoDesign);
            rhoDesignL2 = sqrt(int2d(Th)(rhoDesign^2));

            real ntNewSched = Th.nt;
            real ndofNewSched = Vh.ndof;
            real massAfterSched = int2d(Th)(rhoFromPhi);
            real maxRhoAfterSched = rhoFromPhi[].max;
            real activeAfterSched = int2d(Th)(activeFinal);
            real massRelSched = abs(massAfterSched-massBeforeSched)/max(abs(massBeforeSched), 1e-30);
            real maxRhoRelSched = abs(maxRhoAfterSched-maxRhoBeforeSched)/max(abs(maxRhoBeforeSched), 1e-30);
            real activeRelSched = abs(activeAfterSched-activeBeforeSched)/max(abs(activeBeforeSched), 1e-30);
            real adaptTimeSched = clock()-tAdapt;

            if (saveFrames == 1 && frameAdapt == 1)
            {
                string frameFileAfterAdapt = frameDir + "/" + runTag + "_frame_" + frameCounter + "_ieps_" + ieps + "_k_" + k + "_after_adapt.vtu";
                savevtk(frameFileAfterAdapt, Th, u, rhoFromPhi, rhoDesign, phiDesign,
                    dataname="phi rho rhoDesign phiDesign");
                framelog
                    << frameCounter << "," << runTag << "," << "AFTER_ADAPT" << ","
                    << ieps << "," << k << "," << Th.nt << "," << Vh.ndof << ","
                    << epsPhi << "," << resEuclid << "," << massAfterSched << "," << maxRhoAfterSched << ","
                    << activeAfterSched << "," << int2d(Th)(plateauFinal) << "," << relRhoDesignNow << ","
                    << frameFileAfterAdapt << endl;
                frameCounter++;
            }

            adaptedThisEps = 1;

            cout
                << "ADAPT_SCHEDULE_DONE "
                << "ieps=" << ieps
                << " k=" << k
                << " ntNew=" << ntNewSched
                << " ndofNew=" << ndofNewSched
                << " massRel=" << massRelSched
                << " activeRel=" << activeRelSched
                << " time=" << adaptTimeSched
                << endl;

            adaptlog
                << "ADAPT" << ","
                << runTag << ","
                << ieps << ","
                << k << ","
                << ntOldSched << ","
                << ndofOldSched << ","
                << ntNewSched << ","
                << ndofNewSched << ","
                << epsPhi << ","
                << adaptHMin << ","
                << adaptHMax << ","
                << adaptErr << ","
                << adaptErrG << ","
                << adaptRatio << ","
                << adaptAnisoMax << ","
                << adaptGradWeight << ","
                << massBeforeSched << ","
                << maxRhoBeforeSched << ","
                << massAfterSched << ","
                << maxRhoAfterSched << ","
                << massRelSched << ","
                << maxRhoRelSched << ","
                << activeBeforeSched << ","
                << activeAfterSched << ","
                << activeRelSched << ","
                << adaptTimeSched << ","
                << "SCHEDULED"
                << endl;

            if (plt == 1 && plotAdaptOverlay == 1)
            {
                plot(Th, rhoFromPhi, fill=true, value=true, wait=false, nbiso=60,
                    cmm="After scheduled adapt: rho=f(u) with mesh overlay");
            }

            if (saveFinalOutputs == 1)
            {
                savevtk(vtkDir + "/" + runTag + "_scheduled_adapt_ieps_" + ieps + "_k_" + k + ".vtu", Th, u, rhoFromPhi, rhoDesign, phiDesign,
                    dataname="phi rho rhoDesign phiDesign");
            }

            rr.resize(Vh.ndof);
            rr = 0.0;
            rr = ResidualForm(0, Vh);
            resEuclid = sqrt(rr'*rr);
            res = resEuclid;
        }

        if (nBacktrack <= 1)
        {
            if (useMuShift == 1)
            {
                muShift = max(muMin, muAcceptFactor*muShift);
            }
        }
        else if (nBacktrack >= 8)
        {
            if (useMuShift == 1)
            {
                muShift = min(muMax, muHardBacktrackFactor*muShift);
            }
        }

        real relDrop = abs(resOld-res)/max(resOld, 1e-30);

        if (relDrop < stagnationTol)
        {
            stagnationCount++;
            if (useMuShift == 1)
            {
                muShift = min(muMax, muStagnationFactor*muShift);
            }

            humanlog
                << "SHIFT "
                << "ieps=" << ieps << " "
                << "k=" << k << " "
                << "newMu=" << muShift << " "
                << "reason=stagnation"
                << endl;

            if (stagnationCount >= maxStagnation)
            {
                cout << "EPS_STOP ieps=" << ieps << " reason=repeated_stagnation" << endl;
                humanlog << "EPS_STOP ieps=" << ieps << " reason=repeated_stagnation" << endl;
                break;
            }
        }
        else
        {
            stagnationCount = 0;
        }

        if (plt == 1 && plotDuringNewton == 1 && plotNewtonEvery > 0 && k % plotNewtonEvery == 0)
        {
            plot(u, fill=true, value=true, wait=false, nbiso=50,
                cmm="Newton iterate u");

            rhoFromPhi = ffun(u);
            plot(Th, rhoFromPhi, fill=true, value=true, wait=false, nbiso=50,
                cmm="Newton rho=f(u) with mesh overlay, eps=" + epsPhiRatio + ", resE=" + resEuclid);
        }
    }

    /* inline ComputeFastMetrics */
tMetrics = clock();
rhoFromPhi = ffun(u);
activeFinal = (rhoFromPhi > activeThreshold*rhoAmp);
plateauFinal = (rhoFromPhi > plateauThreshold*rhoAmp);

rr.resize(Vh.ndof);
rr = 0.0;
rr = ResidualForm(0, Vh);
resEuclid = sqrt(rr'*rr);

// H^{-1}_h residual disabled for speed.
// resEuclid is now the only Newton/Armijo residual metric.
resHm1 = 0.0;

rhoL2Now = sqrt(int2d(Th)(rhoFromPhi^2));
energyPhiNow = sqrt(int2d(Th)(dx(u)^2 + dy(u)^2));

resHm1RelEnergy = 0.0;
resHm1RelRho = 0.0;

// Disabled expensive diagnostics for speed.
poissonRelL2 = 0.0;
poissonRelH1 = 0.0;
strongResL2 = 0.0;
strongResRelEnergy = 0.0;
strongResRelRho = 0.0;
strongResMaxAbs = 0.0;
defectL2Now = 0.0;
gradRhoL2Now = 0.0;
normalizedDefectNow = 0.0;

JNow = 0.5*int2d(Th)(dx(u)^2 + dy(u)^2) - int2d(Th)(Ffun(u));

activeAreaNow = int2d(Th)(activeFinal);
plateauAreaNow = int2d(Th)(plateauFinal);
plateauFracNow = plateauAreaNow/max(activeAreaNow, 1e-30);

relRhoDesignNow = sqrt(int2d(Th)((rhoFromPhi-rhoDesign)^2))/max(rhoDesignL2, 1e-30);

metricsTimeNow = clock()-tMetrics;


    cout
        << "EPS_END "
        << "ieps=" << ieps
        << " resE=" << resEuclid
        << " mass=" << int2d(Th)(rhoFromPhi)
        << " maxRho=" << rhoFromPhi[].max
        << endl;

    humanlog
        << "EPS_END "
        << "ieps=" << ieps << " "
        << "epsPhiRatio=" << epsPhiRatio << " "
        << "epsPhi=" << epsPhi << " "
        << "minU=" << u[].min << " "
        << "maxU=" << u[].max << " "
        << "maxRho=" << rhoFromPhi[].max << " "
        << "massRho=" << int2d(Th)(rhoFromPhi) << " "
        << "relRhoDesign=" << relRhoDesignNow << " "
        << "annularPhiMinusC2=" << u[].max-c2Phi << " "
        << "resHm1Disabled=" << resHm1 << " "
        << endl;

    csvlog
        << "EPS_END" << ","
        << runTag << ","
        << ieps << ","
        << epsPhiRatio << ","
        << epsPhi << ","
        << "NA,"
        << Th.nt << ","
        << Vh.ndof << ","
        << resEuclid << ","
        << resHm1 << ","
        << resHm1RelEnergy << ","
        << resHm1RelRho << ","
        << poissonRelL2 << ","
        << poissonRelH1 << ","
        << strongResL2 << ","
        << strongResRelEnergy << ","
        << strongResRelRho << ","
        << strongResMaxAbs << ","
        << "NA,NA,NA,"
        << muShift << ","
        << u[].min << ","
        << u[].max << ","
        << rhoFromPhi[].max << ","
        << int2d(Th)(rhoFromPhi) << ","
        << rhoL2Now << ","
        << energyPhiNow << ","
        << JNow << ","
        << activeAreaNow << ","
        << plateauAreaNow << ","
        << plateauFracNow << ","
        << relRhoDesignNow << ","
        << u[].max-c2Phi << ","
        << defectL2Now << ","
        << normalizedDefectNow << ","
        << gradRhoL2Now << ","
        << "NA,NA,NA,"
        << "EPS_END"
        << endl;

    if (saveFrames == 1 && frameEvery > 0)
    {
        string frameFileEpsEnd = frameDir + "/" + runTag + "_frame_" + frameCounter + "_ieps_" + ieps + "_eps_end.vtu";
        savevtk(frameFileEpsEnd, Th, u, rhoFromPhi, rhoDesign, phiDesign,
            dataname="phi rho rhoDesign phiDesign");
        framelog
            << frameCounter << "," << runTag << "," << "EPS_END" << ","
            << ieps << "," << -1 << "," << Th.nt << "," << Vh.ndof << ","
            << epsPhi << "," << resEuclid << "," << int2d(Th)(rhoFromPhi) << "," << rhoFromPhi[].max << ","
            << activeAreaNow << "," << plateauAreaNow << "," << relRhoDesignNow << ","
            << frameFileEpsEnd << endl;
        frameCounter++;
    }

    // Scheduled adaptation, if enabled, has already occurred inside the Newton loop.

}

// ----------------------------
// Final solution and diagnostics
// ----------------------------
/* inline ComputeFastMetrics */
tMetrics = clock();
rhoFromPhi = ffun(u);
activeFinal = (rhoFromPhi > activeThreshold*rhoAmp);
plateauFinal = (rhoFromPhi > plateauThreshold*rhoAmp);

rr.resize(Vh.ndof);
rr = 0.0;
rr = ResidualForm(0, Vh);
resEuclid = sqrt(rr'*rr);

// H^{-1}_h residual disabled for speed.
// resEuclid is now the only Newton/Armijo residual metric.
resHm1 = 0.0;

rhoL2Now = sqrt(int2d(Th)(rhoFromPhi^2));
energyPhiNow = sqrt(int2d(Th)(dx(u)^2 + dy(u)^2));

resHm1RelEnergy = 0.0;
resHm1RelRho = 0.0;

// Disabled expensive diagnostics for speed.
poissonRelL2 = 0.0;
poissonRelH1 = 0.0;
strongResL2 = 0.0;
strongResRelEnergy = 0.0;
strongResRelRho = 0.0;
strongResMaxAbs = 0.0;
defectL2Now = 0.0;
gradRhoL2Now = 0.0;
normalizedDefectNow = 0.0;

JNow = 0.5*int2d(Th)(dx(u)^2 + dy(u)^2) - int2d(Th)(Ffun(u));

activeAreaNow = int2d(Th)(activeFinal);
plateauAreaNow = int2d(Th)(plateauFinal);
plateauFracNow = plateauAreaNow/max(activeAreaNow, 1e-30);

relRhoDesignNow = sqrt(int2d(Th)((rhoFromPhi-rhoDesign)^2))/max(rhoDesignL2, 1e-30);

metricsTimeNow = clock()-tMetrics;


cout
    << "FINAL "
    << "resE=" << resEuclid
    << " maxPhi=" << u[].max
    << " maxRho=" << rhoFromPhi[].max
    << " mass=" << int2d(Th)(rhoFromPhi)
    << " relDesign=" << relRhoDesignNow
    << endl;

humanlog
    << "FINAL "
    << "resEuclid=" << resEuclid << " "
    << "resHm1Disabled=" << resHm1 << " "
    << "resHm1RelEnergy=" << resHm1RelEnergy << " "
    << "resHm1RelRho=" << resHm1RelRho << " "
    << "poissonRelL2=" << poissonRelL2 << " "
    << "poissonRelH1=" << poissonRelH1 << " "
    << "strongResL2=" << strongResL2 << " "
    << "strongResRelEnergy=" << strongResRelEnergy << " "
    << "strongResRelRho=" << strongResRelRho << " "
    << "strongResMaxAbs=" << strongResMaxAbs << " "
    << "minPhi=" << u[].min << " "
    << "maxPhi=" << u[].max << " "
    << "c1Phi=" << c1Phi << " "
    << "c2Phi=" << c2Phi << " "
    << "epsPhi=" << epsPhi << " "
    << "maxRho=" << rhoFromPhi[].max << " "
    << "massRho=" << int2d(Th)(rhoFromPhi) << " "
    << "relRhoDesign=" << relRhoDesignNow << " "
    << "annularCheckMaxPhiMinusC2=" << u[].max-c2Phi << " "
    << "normalizedDefect=" << normalizedDefectNow << " "
    << "J=" << JNow
    << endl;

humanlog
    << "FINAL_BAND "
    << "activeArea=" << activeAreaNow << " "
    << "plateauArea=" << plateauAreaNow << " "
    << "plateauFraction=" << plateauFracNow
    << endl;

csvlog
    << "FINAL" << ","
    << runTag << ","
    << "NA,NA,"
    << epsPhi << ","
    << "NA,"
    << Th.nt << ","
    << Vh.ndof << ","
    << resEuclid << ","
    << resHm1 << ","
    << resHm1RelEnergy << ","
    << resHm1RelRho << ","
    << poissonRelL2 << ","
    << poissonRelH1 << ","
        << strongResL2 << ","
        << strongResRelEnergy << ","
        << strongResRelRho << ","
        << strongResMaxAbs << ","
    << "NA,NA,NA,"
    << muShift << ","
    << u[].min << ","
    << u[].max << ","
    << rhoFromPhi[].max << ","
    << int2d(Th)(rhoFromPhi) << ","
    << rhoL2Now << ","
    << energyPhiNow << ","
    << JNow << ","
    << activeAreaNow << ","
    << plateauAreaNow << ","
    << plateauFracNow << ","
    << relRhoDesignNow << ","
    << u[].max-c2Phi << ","
    << defectL2Now << ","
    << normalizedDefectNow << ","
    << gradRhoL2Now << ","
    << "NA,NA,"
    << "FINAL"
    << endl;

summary
    << "runTag " << runTag << endl
    << "runDir " << runDir << endl
    << "importDir " << importDir << endl
    << "useStar " << useStar << endl
    << "meshFile " << meshFile << endl
    << "meshReader " << meshReader << endl
    << "starN " << starN << endl
    << "starR0 " << starR0 << endl
    << "starAmp " << starAmp << endl
    << "starMode " << starMode << endl
    << "nt " << Th.nt << endl
    << "ndof " << Vh.ndof << endl
    << "alphaT1 " << alphaT1 << endl
    << "alphaT2 " << alphaT2 << endl
    << "epsTRatio " << epsTRatio << endl
    << "betaPhi1 " << betaPhi1 << endl
    << "betaPhi2 " << betaPhi2 << endl
    << "useMuShift " << useMuShift << endl
    << "muShiftFinal " << muShift << endl
    << "muMin " << muMin << endl
    << "muMax " << muMax << endl
    << "muAcceptFactor " << muAcceptFactor << endl
    << "muHardBacktrackFactor " << muHardBacktrackFactor << endl
    << "muFailFactor " << muFailFactor << endl
    << "muStagnationFactor " << muStagnationFactor << endl
    << "c1Phi " << c1Phi << endl
    << "c2Phi " << c2Phi << endl
    << "epsPhi " << epsPhi << endl
    << "resEuclid " << resEuclid << endl
    << "resHm1 " << resHm1 << endl
    << "resHm1RelEnergy " << resHm1RelEnergy << endl
    << "resHm1RelRho " << resHm1RelRho << endl
    << "massRho " << int2d(Th)(rhoFromPhi) << endl
    << "maxRho " << rhoFromPhi[].max << endl
    << "activeArea " << activeAreaNow << endl
    << "plateauArea " << plateauAreaNow << endl
    << "plateauFrac " << plateauFracNow << endl
    << "relRhoDesign " << relRhoDesignNow << endl
    << "annularPhiMinusC2 " << u[].max-c2Phi << endl
    << "normalizedDefect " << normalizedDefectNow << endl
    << "J " << JNow << endl
    << "equilibriumMesh " << outMesh << endl
    << "rhoDof " << outRhoDof << endl
    << "phiDof " << outPhiDof << endl
    << "finalVTK " << outVTK << endl
    << "timeTotal " << clock()-tGlobal << endl;

if (plt == 1 && plotFinal == 1)
{
    plot(T, fill=true, value=true, wait=true, nbiso=60,
        cmm="Torsion T");

    plot(Th, rhoDesign, fill=true, value=true, wait=true, nbiso=60,
        cmm="Designed rhoDesign = g_T(T), mesh overlay");

    plot(phiDesign, fill=true, value=true, wait=true, nbiso=60,
        cmm="Poisson initializer phiDesign");

    plot(u, fill=true, value=true, wait=true, nbiso=60,
        cmm="Final semilinear phi");

    plot(Th, rhoFromPhi, fill=true, value=true, wait=true, nbiso=60,
        cmm="Final semilinear rho=f(phi), mesh overlay");

}

// ----------------------------
// Save fields for simulation.
// ----------------------------
if (saveFinalOutputs == 1)
{
    // Legacy import names inside a run-specific equilibrium folder.
    savemesh(Th, outMesh);

    {
        ofstream frho(outRhoDof);
        frho << rhoFromPhi[];
    }

    {
        ofstream fphi(outPhiDof);
        fphi << u[];
    }

    // Named copies for bookkeeping/postprocessing.
    savemesh(Th, namedMesh);

    {
        ofstream frhoNamed(namedRhoDof);
        frhoNamed << rhoFromPhi[];
    }

    {
        ofstream fphiNamed(namedPhiDof);
        fphiNamed << u[];
    }
}

if (saveFrames == 1 && frameFinal == 1)
{
    string frameFileFinal = frameDir + "/" + runTag + "_frame_" + frameCounter + "_final.vtu";
    savevtk(frameFileFinal, Th, u, rhoFromPhi, rhoDesign, phiDesign,
        dataname="phi rho rhoDesign phiDesign");
    framelog
        << frameCounter << "," << runTag << "," << "FINAL" << ","
        << nEpsPhi << "," << -1 << "," << Th.nt << "," << Vh.ndof << ","
        << epsPhi << "," << resEuclid << "," << int2d(Th)(rhoFromPhi) << "," << rhoFromPhi[].max << ","
        << int2d(Th)(activeFinal) << "," << int2d(Th)(plateauFinal) << "," << relRhoDesignNow << ","
        << frameFileFinal << endl;
    frameCounter++;
}

if (saveFinalOutputs == 1)
{
    savevtk(outVTK, Th, T, rhoDesign, phiDesign, u, rhoFromPhi, gradTNorm,
        dataname="T rhoDesign phiDesign phiFinal rhoFinal gradTNorm");
}

if (saveFinalOutputs == 1)
{
    cout << "EXPORT importDir=" << importDir << " mesh=" << outMesh << " rho=" << outRhoDof << " phi=" << outPhiDof << " vtk=" << outVTK << endl;
}
else
{
    cout << "EXPORT_SKIPPED saveFinalOutputs=0" << endl;
}
cout << "TIME_TOTAL " << clock()-tGlobal << endl;
cout << "========== END STRATEGY A NOADAPT TORSION NEWTON ==========" << endl;

if (saveFinalOutputs == 1)
{
    humanlog << "EXPORT importDir=" << importDir << " mesh=" << outMesh << " rho=" << outRhoDof << " phi=" << outPhiDof << " vtk=" << outVTK << endl;
}
else
{
    humanlog << "EXPORT_SKIPPED saveFinalOutputs=0" << endl;
}
humanlog << "FRAMES frameDir=" << frameDir << " frameLog=" << frameLogFile << " nFrames=" << frameCounter << endl;
humanlog << "NAMED_EXPORT mesh=" << namedMesh << " rho=" << namedRhoDof << " phi=" << namedPhiDof << endl;
humanlog << "TIME_TOTAL " << clock()-tGlobal << endl;
humanlog << "END runTag=" << runTag << endl;
