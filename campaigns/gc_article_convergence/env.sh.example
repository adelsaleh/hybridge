# Environment of the campaign runs on the cluster: copy to env.sh (or point CAMPAIGN_ENV at a copy) and fill in
# the placeholders. slurm/job.slurm sources it before every shard.
module purge
# module load <cuda-13 toolchain> <python>          # modules providing CUDA 13 and the Python of the venv
# source <venv>/bin/activate                        # venv with hybridge (editable), CuPy for CUDA 13, numba, pyamgx
export HYBRIDGE_PYTHON=python                       # interpreter of the runs (the venv's)
# export HYBRIDGE_CAMPAIGN_OUT=$SCRATCH/gc_article_convergence   # outputs (default: <repo>/run_outputs/campaigns/...)
# export LD_LIBRARY_PATH=<AMGX fork build dir>:$LD_LIBRARY_PATH  # libamgxsh.so of the user-built AMGX fork (sm_90)
export NUMBA_NUM_THREADS=${SLURM_CPUS_PER_TASK:-24}
export NUMBA_CACHE_DIR=${WORK:-$HOME}/.cache/hybridge-numba    # persistent JIT caches (not on $SCRATCH)
export CUPY_CACHE_DIR=${WORK:-$HOME}/.cache/hybridge-cupy
export PYTHONUNBUFFERED=1
